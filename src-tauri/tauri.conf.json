{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Melissm",
  "version": "0.1.4",
  "identifier": "dev.ryne.melissm",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:4321",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
    "app": {
    "enableGTKAppId": true,
    "windows": [
      { "label": "main", "title": "Melissm", "width": 1180, "height": 780, "minWidth": 820, "minHeight": 560 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "targets": [],
    "icon": ["icons/icon.png"],
    "category": "Music",
    "license": "GPL-3.0-or-later"
  }
}
