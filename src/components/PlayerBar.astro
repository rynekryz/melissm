<div id="queue-panel" inert aria-hidden="true" class="lyrics-glass fixed left-3 top-3 bottom-[108px] z-50 flex w-[380px] -translate-x-[115%] flex-col rounded-[28px] p-4 shadow-2xl shadow-black/40 transition-transform duration-500 [transition-timing-function:var(--spring)]">
  <div class="mb-2 flex shrink-0 items-center justify-between px-2">
    <h2 class="text-lg font-medium">Queue</h2>
    <button id="q-clear" class="press grid size-9 place-items-center rounded-full hover:bg-surface-container-highest" aria-label="Clear upcoming"><span class="ms text-on-surface-variant">clear_all</span></button>
  </div>
  <div id="queue-list" class="flex-1 overflow-y-auto pr-2"></div>
</div>

<div id="lyrics-panel" inert aria-hidden="true" class="lyrics-glass fixed right-3 top-3 bottom-[108px] z-50 flex w-[380px] translate-x-[115%] flex-col rounded-[28px] p-4 shadow-2xl shadow-black/40 transition-transform duration-500 [transition-timing-function:var(--spring)]">
  <div class="mb-2 flex shrink-0 items-center justify-between px-2">
    <h2 class="text-lg font-medium">Lyrics</h2>
    <div class="flex gap-1">
      <button id="ly-edit" class="press grid size-9 place-items-center rounded-full hover:bg-surface-container-highest" aria-label="Edit lyrics"><span class="ms text-on-surface-variant">edit</span></button>
      <button id="ly-full" class="press grid size-9 place-items-center rounded-full hover:bg-surface-container-highest" aria-label="Fullscreen lyrics"><span class="ms text-on-surface-variant">fullscreen</span></button>
    </div>
  </div>
  <div id="lyrics-viewport" class="lyrics-mask flex-1 overflow-y-auto pr-2">
    <div id="lyrics-body" class="space-y-6 pb-24 pt-10 text-2xl font-medium leading-snug"></div>
  </div>
  <p id="ly-provider" class="mt-2 shrink-0 px-2 text-xs text-on-surface-variant">Lyrics from LrcLib</p>
</div>

<div id="lyr-full" aria-hidden="true">
  <div id="lyr-frost" class="absolute inset-0"></div>
  <img id="lf-bg" alt="" class="absolute inset-0 size-full scale-125 object-cover" style="opacity:0" />
  <div class="scrim"></div>
  <button id="lf-close" class="press absolute left-8 top-12 z-20 grid size-14 place-items-center rounded-full bg-surface-container/90 text-on-surface shadow-lg shadow-black/30 hover:bg-surface-container-highest" aria-label="Close fullscreen lyrics"><span class="ms">expand_more</span></button>
  <button id="lf-edit" class="press absolute right-8 top-12 z-20 grid size-14 place-items-center rounded-full bg-surface-container/90 text-on-surface shadow-lg shadow-black/30 hover:bg-surface-container-highest" aria-label="Edit lyrics"><span class="ms">edit</span></button>
  <div class="lyr-fs-pop relative z-10 mx-auto flex h-full w-full max-w-[1000px] flex-col px-20 py-24">
    <p id="lf-title" class="mb-8 shrink-0 truncate text-2xl font-medium opacity-70">Nothing playing</p>
    <div class="lyrics-mask min-h-0 flex-1 overflow-y-auto">
      <div id="lf-body" class="space-y-8 pb-40 pt-24 text-3xl font-medium leading-snug"></div>
    </div>
  </div>
</div>

<div id="player" class="glass idle fixed inset-x-3 bottom-3 z-30 flex h-[84px] items-center gap-6 rounded-[32px] px-5 shadow-xl shadow-black/40 transition-colors duration-700">
  <div class="flex w-[28%] min-w-0 items-center gap-4">
    <div id="p-artbox" class="relative size-14 shrink-0 overflow-hidden rounded-2xl bg-surface-container-highest transition-[border-radius] duration-500 [transition-timing-function:var(--spring)]">
      <img id="p-art" alt="" class="absolute inset-0 size-full object-cover" />
      <span id="p-art-fallback" class="absolute inset-0 grid place-items-center"><span class="ms text-on-surface-variant opacity-70">music_note</span></span>
    </div>
    <div class="min-w-0">
      <div id="p-title" class="truncate font-medium">Nothing playing</div>
      <div id="p-artist" class="cursor-pointer truncate text-sm text-on-surface-variant hover:font-semibold">Pick a song you like</div>
    </div>
    <button id="p-like" class="press grid size-12 shrink-0 place-items-center rounded-full hover:bg-surface-container-highest" aria-label="Like"><span id="p-like-icon" class="ms">favorite</span></button>
  </div>

  <div class="flex flex-1 items-center gap-4">
    <button id="p-shuffle" class="press grid size-12 place-items-center rounded-full hover:bg-surface-container-highest" aria-label="Shuffle"><span class="ms">shuffle</span></button>
    <button id="p-prev" class="press grid size-12 place-items-center rounded-full hover:bg-surface-container-highest" aria-label="Previous"><span class="ms fill">skip_previous</span></button>
    <button id="p-play" data-playing="false" class="press play-btn grid size-16 place-items-center bg-primary text-on-primary" aria-label="Play or pause"><span id="p-icon" class="ms fill text-[32px]">play_arrow</span></button>
    <button id="p-next" class="press grid size-12 place-items-center rounded-full hover:bg-surface-container-highest" aria-label="Next"><span class="ms fill">skip_next</span></button>
    <button id="p-repeat" class="press grid size-12 place-items-center rounded-full hover:bg-surface-container-highest" aria-label="Repeat"><span class="ms">repeat</span></button>
    <span id="p-pos" class="w-10 text-right text-xs tabular-nums text-on-surface-variant">0:00</span>
    <div id="p-seek" class="relative h-4 flex-1 cursor-pointer">
      <div id="p-seek-track" class="absolute inset-x-0 top-1/2 h-1 -translate-y-1/2 rounded-full"></div>
      <div id="p-wave" class="wave absolute left-0 top-0 h-4" style="width:0%"></div>
    </div>
    <span id="p-dur" class="w-10 text-xs tabular-nums text-on-surface-variant">0:00</span>
  </div>

  <div class="flex w-[20%] items-center justify-end gap-2">
    <button id="p-queue" class="press icon-toggle grid size-12 place-items-center rounded-full hover:bg-surface-container-highest" aria-label="Queue" aria-expanded="false"><span class="ms">queue_music</span></button>
    <button id="p-lyrics" class="press icon-toggle grid size-12 place-items-center rounded-full hover:bg-surface-container-highest" aria-label="Lyrics" aria-expanded="false"><span class="ms">lyrics</span></button>
    <button id="p-fusion" class="press icon-toggle hidden grid size-12 place-items-center rounded-full hover:bg-surface-container-highest" aria-label="Fussion" title="Fussion (experimental)" aria-pressed="false"><span class="ms">transition_fade</span></button>
    <span id="p-vol-icon" class="ms text-on-surface-variant">volume_up</span>
    <div class="xslider w-28 shrink-0">
      <input id="p-vol" type="range" min="0" max="100" aria-label="Volume" />
      <div class="xtrack"></div>
      <div class="xfill"></div>
      <div class="xhandle"></div>
    </div>
  </div>
</div>

<svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs><clipPath id="fp-shape" clipPathUnits="objectBoundingBox"><path id="fp-shape-path" /></clipPath></defs></svg>

<div id="p-full" aria-hidden="true">
  <img id="fp-bg" alt="" class="absolute inset-0 size-full scale-125 object-cover blur-[64px]" style="opacity:0" />
  <div class="absolute inset-0 scrim"></div>
  <button id="fp-close" class="press absolute left-8 top-8 z-20 grid size-14 place-items-center rounded-full bg-surface-container/90 text-on-surface shadow-lg shadow-black/30 hover:bg-surface-container-highest" aria-label="Close player"><span class="ms">expand_more</span></button>
  <div class="fp-pop relative z-10 mx-auto grid h-full w-full max-w-[1400px] grid-cols-[minmax(0,1fr)_minmax(0,1.2fr)] items-center gap-16 px-24 py-10">
    <div class="relative mx-auto aspect-square w-full max-w-[min(40vw,68vh)]">
      <div id="fp-art-base" class="absolute inset-0 grid place-items-center bg-surface-container-highest"><span class="ms text-on-surface-variant opacity-60" style="font-size:64px">music_note</span></div>
      <img id="fp-art-a" alt="" class="fp-art absolute inset-0 size-full object-cover" />
      <img id="fp-art-b" alt="" class="fp-art absolute inset-0 size-full object-cover" />
    </div>
    <div class="flex min-w-0 flex-col justify-center">
      <h1 id="fp-title" class="line-clamp-3 text-6xl font-semibold tracking-tight">Nothing playing</h1>
      <p id="fp-artist" class="mt-3 cursor-pointer text-2xl text-on-surface-variant hover:font-semibold">Pick a song you like</p>
      <div class="mt-10 flex items-center gap-4">
        <span id="fp-pos" class="w-12 text-right text-sm tabular-nums text-on-surface-variant">0:00</span>
        <div id="fp-seek" class="xslider min-w-0 flex-1">
          <input id="fp-seek-input" type="range" min="0" max="1000" step="1" aria-label="Seek" />
          <div class="xtrack"></div>
          <div class="xfill"></div>
          <div class="xhandle"></div>
        </div>
        <span id="fp-dur" class="w-12 text-sm tabular-nums text-on-surface-variant">0:00</span>
      </div>
      <div class="mt-6 flex flex-wrap items-center gap-2">
        <button id="fp-like" class="press grid size-14 place-items-center rounded-full hover:bg-surface-container-highest" aria-label="Like"><span id="fp-like-icon" class="ms text-[26px]">favorite</span></button>
        <button id="fp-shuffle" class="press grid size-14 place-items-center rounded-full hover:bg-surface-container-highest" aria-label="Shuffle"><span class="ms text-[26px]">shuffle</span></button>
        <button id="fp-prev" class="press grid size-16 place-items-center rounded-full hover:bg-surface-container-highest" aria-label="Previous"><span class="ms fill text-[30px]">skip_previous</span></button>
        <button id="fp-play" data-playing="false" class="press play-btn grid size-20 place-items-center bg-primary text-on-primary shadow-xl shadow-black/30" aria-label="Play or pause"><span id="fp-icon" class="ms fill text-[40px]">play_arrow</span></button>
        <button id="fp-next" class="press grid size-16 place-items-center rounded-full hover:bg-surface-container-highest" aria-label="Next"><span class="ms fill text-[30px]">skip_next</span></button>
        <button id="fp-repeat" class="press grid size-14 place-items-center rounded-full hover:bg-surface-container-highest" aria-label="Repeat"><span id="fp-repeat-icon" class="ms text-[26px]">repeat</span></button>
        <button id="fp-queue" class="press icon-toggle grid size-14 place-items-center rounded-full hover:bg-surface-container-highest" aria-label="Queue" aria-expanded="false"><span class="ms text-[26px]">queue_music</span></button>
        <button id="fp-lyrics" class="press icon-toggle grid size-14 place-items-center rounded-full hover:bg-surface-container-highest" aria-label="Lyrics" aria-expanded="false"><span class="ms text-[26px]">lyrics</span></button>
        <button id="fp-fusion" class="press icon-toggle hidden grid size-14 place-items-center rounded-full hover:bg-surface-container-highest" aria-label="Fussion" title="Fussion (experimental)" aria-pressed="false"><span class="ms text-[26px]">transition_fade</span></button>
      </div>
      <div class="mt-8 flex w-72 items-center gap-3">
        <span id="fp-vol-icon" class="ms text-on-surface-variant">volume_up</span>
        <div id="fp-vol" class="xslider min-w-0 flex-1">
          <input id="fp-vol-input" type="range" min="0" max="100" aria-label="Volume" />
          <div class="xtrack"></div>
          <div class="xfill"></div>
          <div class="xhandle"></div>
        </div>
      </div>
    </div>
  </div>

  <div id="fp-lyr-wrap" aria-hidden="true">
    <p id="fpl-title" class="mb-6 shrink-0 truncate text-2xl font-medium opacity-70">Nothing playing</p>
    <div class="lyrics-mask min-h-0 flex-1 overflow-y-auto">
      <div id="fpl-body" class="space-y-7 pb-24 pt-6 text-2xl font-medium leading-snug"></div>
    </div>
  </div>
</div>

<script>
  import { current, cycleRepeat, next, onError, previous, playAt, removeFromQueue, moveInQueue, clearUpcoming, seek, setVolume, subscribe, toggle, toggleShuffle, type PlayerState } from '../lib/player';
  import { isLiked, refreshHistory, toggleLike } from '../lib/library';
  import { getSettings, isTauri, lyrics, lyricsDeleteCustom, lyricsGetCustom, lyricsSaveCustom, setFusion } from '../lib/api';
  import { esc, fmt } from '../lib/ui';
  import { navigate } from 'astro:transitions/client';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const bar = $('player');
  const panel = $('lyrics-panel');
  const qPanel = $('queue-panel');
  const qList = $('queue-list');
  const lyrFull = $('lyr-full');
  const lfBody = $('lf-body');
  const fplBody = $('fpl-body');
  const body = $('lyrics-body');
  const viewport = $('lyrics-viewport');
  const art = $<HTMLImageElement>('p-art');
  const artFallback = $('p-art-fallback');
  const vol = $<HTMLInputElement>('p-vol');
  const full = $('p-full');
  const fpSeek = $('fp-seek');
  const fpSeekInput = $<HTMLInputElement>('fp-seek-input');
  const fpVol = $('fp-vol');
  const fpVolInput = $<HTMLInputElement>('fp-vol-input');
  let lines: { t: number; text: string; words?: { w: string; s: number }[] }[] = [];
  let lyricsFor = '';
  let lyricsGen = 0;
  let lyricsFailId = '';
  let lyricsFailAt = 0;
  let activeLine = -1;
  let isCustom = false;
  let fsOpen = false;
  let panelClose = true;
  let fusionOn = false;
  let fusionUi = false;
  let lastSynced = '';
  const lycOffset = () => parseFloat(localStorage.getItem('melissm.lyrics_offset') ?? '0') || 0;
  const failedLyricsForCurrent = () => !!current() && current()!.id === lyricsFailId;
  const paintFusion = () => {
    for (const id of ['p-fusion', 'fp-fusion']) {
      const el = $(id);
      el.classList.toggle('hidden', !fusionUi);
      el.classList.toggle('is-on', fusionOn && fusionUi);
      el.setAttribute('aria-pressed', String(fusionOn && fusionUi));
    }
  };
  const toggleFusion = () => {
    fusionOn = !fusionOn;
    paintFusion();
    if (isTauri) void setFusion(fusionOn).catch(() => {});
  };
  $('p-fusion').onclick = toggleFusion;
  $('fp-fusion').onclick = toggleFusion;
  paintFusion();
  if (isTauri)
    void getSettings()
      .then((s) => {
        panelClose = s.panel_close !== '0';
        fusionUi = s.fusion_ui === '1';
        fusionOn = fusionUi && s.fusion === '1';
        paintFusion();
      })
      .catch(() => {});
  window.addEventListener('melissm:panel-close', (e) => (panelClose = (e as CustomEvent<boolean>).detail));
  window.addEventListener('melissm:fusion-ui', (e) => {
    fusionUi = (e as CustomEvent<boolean>).detail;
    if (!fusionUi) fusionOn = false;
    paintFusion();
  });

  const polar = (fn: (a: number) => number, steps = 220) => {
    let d = '';
    for (let i = 0; i <= steps; i++) {
      const a = (i / steps) * Math.PI * 2;
      const r = Math.max(0.05, Math.min(1, fn(a)));
      d += `${i ? 'L' : 'M'}${(0.5 + (r * Math.cos(a)) / 2).toFixed(4)} ${(0.5 + (r * Math.sin(a)) / 2).toFixed(4)}`;
    }
    return d + 'Z';
  };
  const FNS = [
    (a: number) => 0.85 + 0.15 * Math.cos(12 * a),
    (a: number) => 0.7 + 0.3 * Math.abs(Math.cos(6 * a)) ** 0.75,
    (a: number) => 0.78 + 0.22 * Math.cos(8 * a),
    (a: number) => 0.8 + 0.2 * Math.cos(4 * a),
    (a: number) => 0.9 + 0.1 * Math.cos(2 * a),
    (a: number) => 0.68 + 0.32 * Math.abs(Math.cos(5 * a)) ** 0.85,
  ];
  const clipEl = $('fp-shape-path');
  let curFn = FNS[0];
  clipEl.setAttribute('d', polar(curFn));
  const morphTo = (fn: (a: number) => number) => {
    const from = curFn;
    curFn = fn;
    const t0 = performance.now();
    const step = (now: number) => {
      const k = Math.min(1, (now - t0) / 650);
      const e = 1 - Math.pow(1 - k, 3);
      clipEl.setAttribute('d', polar((a) => from(a) + (fn(a) - from(a)) * e));
      if (k < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  };
  let front = 'a';
  let songCount = 0;
  let lastTrackId = '';
  let curArtistId: string | null = null;
  const openArtist = () => {
    if (curArtistId) navigate(`/artist?id=${curArtistId}`);
  };
  $('p-artist').onclick = openArtist;
  $('fp-artist').onclick = openArtist;

  const parseLrc = (lrc: string) =>
    lrc
      .split('\n')
      .map((l) => l.match(/^\[(\d+):(\d+(?:\.\d+)?)\](.*)$/))
      .filter((m): m is RegExpMatchArray => !!m)
      .map((m) => ({ t: +m[1] * 60 + +m[2], text: m[3].trim() }));

  vol.value = '100';
  fpVolInput.value = vol.value;

  let qSig = '';
  let prevQueueIds = new Set<string>();
  const renderQueue = (s: PlayerState) => {
    const sig = s.tracks.map((t) => t.id).join('|');
    if (sig !== qSig) {
      qSig = sig;
      let born = 0;
      qList.innerHTML = s.tracks
        .map((t, i) => {
          const fresh = prevQueueIds.size > 0 && !prevQueueIds.has(t.id);
          const delay = fresh ? ` style="animation-delay:${born++ * 35}ms"` : '';
          return `<div class="qrow${fresh ? ' qrow-in' : ''}" draggable="true" data-i="${i}" data-id="${t.id}"${delay}>
            ${t.thumbnail ? `<img src="${esc(t.thumbnail)}" alt="" loading="lazy" class="size-10 shrink-0 rounded-xl object-cover" />` : '<div class="grid size-10 shrink-0 place-items-center rounded-xl bg-surface-container-highest"><span class="ms text-on-surface-variant opacity-60">music_note</span></div>'}
            <div class="min-w-0 flex-1"><div class="truncate text-sm font-medium">${esc(t.title)}</div><div class="truncate text-xs opacity-70">${esc(t.artist)}</div></div>
            <button data-qrm class="press grid size-8 shrink-0 place-items-center rounded-full hover:bg-surface-container-highest" aria-label="Remove"><span class="ms text-on-surface-variant">close</span></button>
          </div>`;
        })
        .join('');
      prevQueueIds = new Set(s.tracks.map((t) => t.id));
    }
    qList.querySelectorAll<HTMLElement>('.qrow').forEach((row) => {
      row.classList.toggle('on', +row.dataset.i! === s.index);
      row.classList.toggle('past', +row.dataset.i! < s.index);
    });
  };
  let dragI = -1;
  qList.addEventListener('dragstart', (e) => {
    const row = (e.target as HTMLElement).closest<HTMLElement>('.qrow');
    if (!row) return;
    dragI = +row.dataset.i!;
    e.dataTransfer!.effectAllowed = 'move';
  });
  qList.addEventListener('dragover', (e) => e.preventDefault());
  qList.addEventListener('drop', (e) => {
    e.preventDefault();
    const row = (e.target as HTMLElement).closest<HTMLElement>('.qrow');
    if (row && dragI >= 0 && +row.dataset.i! !== dragI) moveInQueue(dragI, +row.dataset.i!);
    dragI = -1;
  });
  qList.addEventListener('click', (e) => {
    const row = (e.target as HTMLElement).closest<HTMLElement>('.qrow');
    if (!row) return;
    if ((e.target as HTMLElement).closest('[data-qrm]')) {
      removeFromQueue(+row.dataset.i!);
      return;
    }
    playAt(+row.dataset.i!);
  });
  $('q-clear').onclick = clearUpcoming;
  const setQueue = (open: boolean) => {
    qPanel.classList.toggle('-translate-x-[115%]', !open);
    qPanel.classList.toggle('open', open);
    qPanel.inert = !open;
    qPanel.setAttribute('aria-hidden', String(!open));
    for (const id of ['p-queue', 'fp-queue']) {
      const b = $(id);
      b.classList.toggle('is-on', open);
      b.setAttribute('aria-expanded', String(open));
    }
  };
  setQueue(false);
  const toggleQueue = () => setQueue(qPanel.classList.contains('-translate-x-[115%]'));
  $('p-queue').onclick = toggleQueue;
  $('fp-queue').onclick = toggleQueue;

  onError((msg) => {
    $('p-artist').textContent = msg.includes('no playable stream') ? 'Playback failed, try another song' : 'Something went wrong';
  });

  async function loadLyrics() {
    const track = current();
    if (!track || lyricsFor === track.id) return;
    if (track.id === lyricsFailId && Date.now() - lyricsFailAt < 15000) return;
    const gen = ++lyricsGen;
    lyricsFor = track.id;
    lines = [];
    activeLine = -1;
    isCustom = false;
    lastSynced = '';
    body.innerHTML = '<p class="text-on-surface-variant">Looking for lyrics…</p>';
    lfBody.innerHTML = '';
    fplBody.innerHTML = '';
    try {
      const l = await lyrics(track);
      if (gen !== lyricsGen || lyricsFor !== track.id) return;
      isCustom = l.custom;
      lastSynced = l.synced ?? '';
      const off = lycOffset();
      if (l.karaoke) {
        lines = l.karaoke.map((k) => ({
          t: k.start + off,
          text: k.text,
          words: k.words?.map((w) => ({ w: w.t, s: w.s + off })),
        }));
      } else if (l.synced) {
        lines = parseLrc(l.synced).map((x) => ({ ...x, t: x.t + off }));
      } else if (l.plain) {
        $('ly-provider').textContent = l.custom ? 'Your lyrics' : `Lyrics from ${l.provider || 'LrcLib'}`;
        body.innerHTML = l.plain.split('\n').map((x) => `<p>${esc(x)}</p>`).join('');
        lfBody.innerHTML = l.plain.split('\n').map((x) => `<p class="lyric">${esc(x)}</p>`).join('');
        fplBody.innerHTML = l.plain.split('\n').map((x) => `<p>${esc(x)}</p>`).join('');
        return;
      } else {
        $('ly-provider').textContent = l.custom ? 'Your lyrics' : `Lyrics from ${l.provider || 'LrcLib'}`;
        body.innerHTML = '<p class="text-on-surface-variant">No lyrics for this one. Hit the pencil to write your own.</p>';
        lfBody.innerHTML = '';
        fplBody.innerHTML = '';
        return;
      }
      $('ly-provider').textContent = l.custom ? 'Your lyrics' : `Lyrics from ${l.provider || 'LrcLib'}`;
      paintLines();
    } catch {
      if (gen !== lyricsGen) return;
      lyricsFor = '';
      lyricsFailId = track.id;
      lyricsFailAt = Date.now();
      lines = [];
      activeLine = -1;
      body.innerHTML = '<p class="text-on-surface-variant">Could not load lyrics. Check your connection.</p>';
      lfBody.innerHTML = '';
      fplBody.innerHTML = '';
    }
  }

  const paintLines = () => {
    const render = (el: HTMLElement, big: boolean) => {
      if (!lines.length) {
        if (big) el.innerHTML = '';
        return;
      }
      el.innerHTML = lines
        .map((x) =>
          x.words
            ? `<p class="lyric" data-l="${lines.indexOf(x)}">${x.words.map((w) => `<span class="kw" data-s="${w.s}">${esc(w.w)}</span>`).join('')}</p>`
            : `<p class="lyric" data-l="${lines.indexOf(x)}">${esc(x.text) || '♪'}</p>`,
        )
        .join('');
    };
    render(body, false);
    render(lfBody, true);
    render(fplBody, false);
    activeLine = -1;
  };

  const setFpLyr = (on: boolean) => {
    full.classList.toggle('fp-lyr', on);
    $('fp-lyr-wrap').setAttribute('aria-hidden', String(!on));
    const b = $('fp-lyrics');
    b.classList.toggle('is-on', on);
    b.setAttribute('aria-expanded', String(on));
    if (on) {
      setPanel(false);
      setQueue(false);
      loadLyrics();
    }
  };
  const openFull = () => {
    full.classList.add('open');
    full.setAttribute('aria-hidden', 'false');
    if (panelClose) {
      setPanel(false);
      setQueue(false);
    }
    loadLyrics();
  };
  const closeFull = () => {
    setFpLyr(false);
    full.classList.remove('open');
    full.setAttribute('aria-hidden', 'true');
  };
  bar.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('button, .xslider, #p-seek, #p-artist')) return;
    openFull();
  });
  $('fp-close').onclick = closeFull;
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (editorOpen) {
      editBack()?.remove();
      editorOpen = false;
      return;
    }
    if (fsOpen) {
      closeFsLyrics();
      return;
    }
    if (full.classList.contains('fp-lyr')) {
      setFpLyr(false);
      return;
    }
    if (full.classList.contains('open')) {
      closeFull();
      return;
    }
    if (qPanel.classList.contains('open')) {
      setQueue(false);
      return;
    }
    if (panel.classList.contains('open')) setPanel(false);
  });

  const syncFpControls = (playing: boolean, shuffle: boolean, repeat: string) => {
    $('fp-icon').textContent = playing ? 'pause' : 'play_arrow';
    $('fp-play').dataset.playing = String(playing);
    $('fp-shuffle').firstElementChild!.className = `ms text-[26px] ${shuffle ? 'fill text-primary' : ''}`;
    $('fp-repeat-icon').className = `ms text-[26px] ${repeat !== 'off' ? 'fill text-primary' : ''}`;
    $('fp-repeat-icon').textContent = repeat === 'one' ? 'repeat_one' : 'repeat';
  };

  const setArt = (src: string) => {
    const a = $<HTMLImageElement>('fp-art-a');
    const b = $<HTMLImageElement>('fp-art-b');
    const base = $('fp-art-base');
    const back = front === 'a' ? b : a;
    const frontEl = front === 'a' ? a : b;
    if (!src) {
      a.style.opacity = '0';
      b.style.opacity = '0';
      base.style.opacity = '1';
      return;
    }
    base.style.opacity = '0';
    back.src = src;
    morphTo(FNS[songCount % FNS.length]);
    back.style.transform = 'rotate(14deg) scale(1.15)';
    requestAnimationFrame(() => {
      back.style.opacity = '1';
      back.style.transform = 'rotate(0deg) scale(1)';
      frontEl.style.opacity = '0';
      frontEl.style.transform = 'rotate(-14deg) scale(1.15)';
    });
    front = front === 'a' ? 'b' : 'a';
    songCount++;
  };

  const setPanel = (open: boolean) => {
    panel.classList.toggle('translate-x-[115%]', !open);
    panel.classList.toggle('open', open);
    panel.inert = !open;
    panel.setAttribute('aria-hidden', String(!open));
    for (const id of ['p-lyrics', 'fp-lyrics']) {
      const b = $(id);
      b.classList.toggle('is-on', open);
      b.setAttribute('aria-expanded', String(open));
    }
  };
  setPanel(false);
  const togglePanel = () => {
    const open = panel.classList.contains('translate-x-[115%]');
    if (open && failedLyricsForCurrent()) {
      lyricsFor = '';
      lyricsFailId = '';
    }
    setPanel(open);
    if (open) loadLyrics();
  };
  $('p-lyrics').onclick = togglePanel;
  const toggleFpLyr = () => setFpLyr(!full.classList.contains('fp-lyr'));
  $('fp-lyrics').onclick = toggleFpLyr;
  const openFsLyrics = () => {
    fsOpen = true;
    lyrFull.classList.add('open');
    lyrFull.setAttribute('aria-hidden', 'false');
    setPanel(false);
    setQueue(false);
    loadLyrics();
  };
  const closeFsLyrics = () => {
    fsOpen = false;
    lyrFull.classList.remove('open');
    lyrFull.setAttribute('aria-hidden', 'true');
  };
  $('ly-full').onclick = openFsLyrics;
  $('lf-close').onclick = closeFsLyrics;
  $('lf-edit').onclick = openEditor;
  $('ly-edit').onclick = openEditor;
  window.addEventListener('melissm:lyr-offset', () => {
    lyricsFor = '';
    void loadLyrics();
  });
  const editBack = () => $('ly-edit-back');
  let editorOpen = false;
  async function openEditor() {
    const track = current();
    if (!track || editorOpen) return;
    editorOpen = true;
    const existing = isCustom ? await lyricsGetCustom(track.id) : lastSynced;
    const back = document.createElement('div');
    back.id = 'ly-edit-back';
    back.className = 'modal-back fixed inset-0 z-[80] grid place-items-center bg-black/50 p-6 backdrop-blur-lg';
    back.innerHTML = `<div class="modal-card flex w-full max-w-xl flex-col rounded-[28px] bg-surface-container-high p-6 shadow-2xl shadow-black/50">
      <p class="mb-4 text-lg font-medium">Edit lyrics</p>
      <textarea id="ly-edit-text" spellcheck="false" placeholder="Plain text, or add [mm:ss.xx] for sync" class="h-72 w-full resize-none rounded-2xl bg-surface-container-highest p-4 text-sm leading-relaxed outline-none">${existing ? esc(existing) : ''}</textarea>
      <div class="mt-4 flex justify-end gap-2">
        ${isCustom ? '<button data-reset class="press h-12 rounded-full bg-surface-container-highest px-6 font-medium">Reset</button>' : ''}
        <button data-cancel class="press h-12 rounded-full bg-surface-container-highest px-6 font-medium">Cancel</button>
        <button data-save class="press h-12 rounded-full bg-primary px-6 font-medium text-on-primary">Save</button>
      </div>
    </div>`;
    document.body.appendChild(back);
    const done = () => {
      back.remove();
      editorOpen = false;
    };
    back.querySelector('[data-cancel]')!.addEventListener('click', done);
    back.addEventListener('click', (e) => {
      if (e.target === back) done();
    });
    back.querySelector('[data-save]')!.addEventListener('click', async () => {
      const text = (back.querySelector('#ly-edit-text') as HTMLTextAreaElement).value;
      if (text.trim()) await lyricsSaveCustom(track.id, text);
      else await lyricsDeleteCustom(track.id);
      lyricsFor = '';
      done();
      loadLyrics();
    });
    const reset = back.querySelector('[data-reset]');
    reset?.addEventListener('click', async () => {
      await lyricsDeleteCustom(track.id);
      lyricsFor = '';
      done();
      loadLyrics();
    });
  }
  $('p-play').onclick = toggle;
  $('p-next').onclick = next;
  $('p-prev').onclick = previous;
  $('p-shuffle').onclick = toggleShuffle;
  $('p-repeat').onclick = cycleRepeat;
  $('fp-play').onclick = toggle;
  $('fp-next').onclick = next;
  $('fp-prev').onclick = previous;
  $('fp-shuffle').onclick = toggleShuffle;
  $('fp-repeat').onclick = cycleRepeat;
  const doLike = (iconId: string) => {
    const t = current();
    if (!t) return;
    toggleLike(t);
    $(iconId).className = `ms ${isLiked(t.id) ? 'fill text-primary' : ''}`;
  };
  $('p-like').onclick = () => doLike('p-like-icon');
  $('fp-like').onclick = () => doLike('fp-like-icon');
  vol.oninput = (e) => {
    const v = +(e.target as HTMLInputElement).value / 100;
    fpVolInput.value = (e.target as HTMLInputElement).value;
    setVolume(v);
  };
  fpVolInput.oninput = (e) => {
    const raw = (e.target as HTMLInputElement).value;
    vol.value = raw;
    setVolume(+raw / 100);
  };
  $('p-seek').onclick = (e) => {
    const r = $('p-seek').getBoundingClientRect();
    const dur = current() ? Number($('p-dur').dataset.s) : 0;
    if (dur) seek(((e.clientX - r.left) / r.width) * dur);
  };
  fpSeekInput.addEventListener('input', () => {
    const ratio = +fpSeekInput.value / 1000;
    paintSlider(fpSeek, 1000, +fpSeekInput.value);
    $('fp-pos').textContent = fmt(ratio * Number($('fp-dur').dataset.s || '0'));
  });
  fpSeekInput.addEventListener('change', () => {
    const dur = Number($('fp-dur').dataset.s || '0');
    if (dur) seek((+fpSeekInput.value / 1000) * dur);
  });

  const paintSlider = (el: HTMLElement, max: number, val: number) => {
    const ratio = Math.min(1, Math.max(0, val / max));
    el.style.setProperty('--p', `${ratio * 100}%`);
    el.style.setProperty('--p-num', String(ratio));
    el.dataset.at = ratio <= 0.001 ? 'start' : ratio >= 0.999 ? 'end' : 'mid';
  };

  subscribe((s) => {
    const t = s.tracks[s.index];
    const has = !!t;
    if (has) {
      if (t.thumbnail) {
        if (art.getAttribute('src') !== t.thumbnail) art.src = t.thumbnail;
        art.style.display = '';
        artFallback.style.display = 'none';
      } else {
        art.style.display = 'none';
        artFallback.style.display = '';
      }
      $('p-title').textContent = t.title;
      $('p-artist').textContent = t.artist || t.album || 'Unknown artist';
      curArtistId = t.artist_id ?? null;
      $('p-like-icon').className = `ms ${isLiked(t.id) ? 'fill text-primary' : ''}`;
      $('fp-like-icon').className = `ms text-[26px] ${isLiked(t.id) ? 'fill text-primary' : ''}`;
      if (t.id !== lastTrackId) {
        lastTrackId = t.id;
        refreshHistory();
        $('fp-title').textContent = t.title;
        $('fp-artist').textContent = t.artist || t.album || 'Unknown artist';
        $('lf-title').textContent = t.title;
        $('fpl-title').textContent = t.title;
        const bg = $<HTMLImageElement>('fp-bg');
        const lbg = $<HTMLImageElement>('lf-bg');
        if (bg.getAttribute('src') !== (t.thumbnail || '')) bg.src = t.thumbnail || '';
        if (lbg.getAttribute('src') !== (t.thumbnail || '')) lbg.src = t.thumbnail || '';
        lbg.style.opacity = t.thumbnail ? '1' : '0';
        bg.style.opacity = t.thumbnail ? '1' : '0';
        setArt(t.thumbnail);
      }
    } else {
      art.removeAttribute('src');
      art.style.display = 'none';
      artFallback.style.display = '';
      $('p-title').textContent = 'Nothing playing';
      $('p-artist').textContent = 'Pick a song you like';
      $('p-like-icon').className = 'ms';
    }
    $('p-icon').textContent = s.loading ? 'hourglass_empty' : s.playing ? 'pause' : 'play_arrow';
    $('p-play').dataset.playing = String(s.playing);
    $('p-shuffle').firstElementChild!.className = `ms ${s.shuffle ? 'fill text-primary' : ''}`;
    $('p-repeat').firstElementChild!.className = `ms ${s.repeat !== 'off' ? 'fill text-primary' : ''}`;
    $('p-repeat').firstElementChild!.textContent = s.repeat === 'one' ? 'repeat_one' : 'repeat';
    $('p-artbox').style.borderRadius = s.playing ? '28px' : '16px';
    bar.classList.toggle('idle', !s.playing);
    bar.classList.toggle('empty', !has);
    $('p-pos').textContent = fmt(s.position);
    $('p-dur').textContent = fmt(s.duration);
    $('p-dur').dataset.s = String(s.duration);
    $('fp-dur').dataset.s = String(s.duration);
    const pct = `${s.duration ? Math.min(100, (s.position / s.duration) * 100) : 0}%`;
    $('p-wave').style.width = pct;
    $('p-seek').style.setProperty('--p', pct);
    if (!fpSeek.classList.contains('dragging')) {
      const ratio = s.duration ? Math.min(1, s.position / s.duration) : 0;
      fpSeekInput.value = String(Math.round(ratio * 1000));
      paintSlider(fpSeek, 1000, ratio * 1000);
      $('fp-pos').textContent = fmt(s.position);
      $('fp-dur').textContent = fmt(s.duration);
    }
    if (!fpVol.classList.contains('dragging')) {
      vol.value = String(Math.round(s.volume * 100));
      fpVolInput.value = vol.value;
      paintSlider(vol, 100, s.volume * 100);
      paintSlider(fpVol, 100, +vol.value);
    }
    const volIcon = s.volume <= 0.001 ? 'volume_off' : s.volume < 0.5 ? 'volume_down' : 'volume_up';
    $('p-vol-icon').textContent = volIcon;
    $('fp-vol-icon').textContent = volIcon;
    renderQueue(s);
    syncFpControls(s.playing, s.shuffle, s.repeat);
    if (has && (fsOpen || full.classList.contains('fp-lyr') || !panel.classList.contains('translate-x-[115%]'))) loadLyrics();
    if (lines.length) {
      const i = lines.findLastIndex((l) => l.t <= s.position + 0.15);
      if (i !== activeLine) {
        for (const el of [body, lfBody, fplBody]) {
          el.querySelector('.on')?.classList.remove('on');
          el.querySelector<HTMLElement>(`[data-l="${i}"]`)?.classList.add('on');
        }
      const centerIn = (mask: HTMLElement, el: HTMLElement | null) => {
        if (!el) return;
        const m = mask.getBoundingClientRect();
        const r = el.getBoundingClientRect();
        mask.scrollTo({ top: mask.scrollTop + r.top - m.top - (m.height - r.height) / 2, behavior: 'smooth' });
      };
      centerIn(viewport, body.querySelector<HTMLElement>(`[data-l="${i}"]`));
      if (fsOpen) centerIn(lfBody.parentElement as HTMLElement, lfBody.querySelector<HTMLElement>(`[data-l="${i}"]`));
      if (full.classList.contains('fp-lyr')) centerIn(fplBody.parentElement as HTMLElement, fplBody.querySelector<HTMLElement>(`[data-l="${i}"]`));
        activeLine = i;
      }
      const line = lines[i];
      if (line?.words && fsOpen) {
        lfBody.querySelectorAll<HTMLElement>(`.kw.on-word`).forEach((w) => w.classList.remove('on-word'));
        for (const w of lfBody.querySelectorAll<HTMLElement>(`[data-l="${i}"] .kw`)) {
          if (+w.dataset.s! <= s.position + 0.15) w.classList.add('on-word');
        }
      }
      if (line?.words && full.classList.contains('fp-lyr')) {
        fplBody.querySelectorAll<HTMLElement>(`.kw.on-word`).forEach((w) => w.classList.remove('on-word'));
        for (const w of fplBody.querySelectorAll<HTMLElement>(`[data-l="${i}"] .kw`)) {
          if (+w.dataset.s! <= s.position + 0.15) w.classList.add('on-word');
        }
      }
    }
  });
</script>
