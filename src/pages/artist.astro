---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Artist">
  <div id="head" class="mb-8 flex items-center gap-8">
    <div class="size-44 shrink-0 rounded-full skeleton"></div>
    <div class="flex-1 space-y-4"><div class="h-9 w-64 max-w-full skeleton"></div></div>
  </div>
  <div id="content" class="space-y-10"></div>
  <p id="status" class="text-on-surface-variant"></p>
</Layout>
<script>
  import { artist } from '../lib/api';
  import { playQueue } from '../lib/player';
  import type { Track } from '../lib/player';
  import { artUrl, esc, renderCards, renderTracks } from '../lib/ui';
  import { onPage } from '../lib/page';

  onPage('/artist', async () => {
    const id = new URLSearchParams(location.search).get('id');
    if (!id) return;
    const head = document.getElementById('head')!;
    const content = document.getElementById('content')!;
    const status = document.getElementById('status')!;
    try {
      const page = await artist(id);
      if (!head.isConnected) return;
      document.title = `${page.name} · Melissm`;
      head.innerHTML = `
        ${page.thumbnail ? `<img src="${esc(artUrl(page.thumbnail, 176))}" alt="" data-art="${esc(page.thumbnail)}" data-artcss="176" class="size-44 shrink-0 rounded-full object-cover shadow-lg shadow-black/30" />` : '<div class="size-44 shrink-0 rounded-full bg-surface-container-highest grid place-items-center"><span class="ms text-on-surface-variant opacity-60" style="font-size:64px">person</span></div>'}
        <div class="min-w-0 flex-1">
          <h1 class="truncate text-5xl font-semibold tracking-tight">${esc(page.name)}</h1>
        </div>`;
      content.innerHTML = '';
      if (page.top.length) {
        const sec = document.createElement('section');
        sec.className = 'section-in';
        sec.innerHTML = `<h2 class="mb-3 text-2xl font-medium">Popular</h2><div class="space-y-1"></div>`;
        content.appendChild(sec);
        renderTracks(sec.querySelector('div')!, page.top);
      }
      const rows: [string, Track[]][] = [
        ['Albums', page.albums],
        ['Singles', page.singles],
      ];
      for (const [title, cards] of rows) {
        if (!cards.length) continue;
        const sec = document.createElement('section');
        sec.className = 'section-in';
        sec.innerHTML = `<h2 class="mb-4 text-2xl font-medium"></h2><div class="h-row flex"></div>`;
        sec.querySelector('h2')!.textContent = title;
        renderCards(sec.querySelector('div')!, cards, { row: true });
        content.appendChild(sec);
      }
    } catch (e) {
      if (status.isConnected) status.textContent = `Could not load this artist: ${e}`;
    }
  });
</script>
