---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Settings">
  <h1 class="mb-8 text-5xl font-semibold tracking-tight">Settings</h1>

  <section class="mb-6 max-w-3xl rounded-[28px] bg-surface-container p-6">
    <h2 class="mb-1 text-xl font-medium">Appearance</h2>
    <p class="mb-5 text-sm text-on-surface-variant">Colors follow your wallpaper. Pick the mood.</p>
    <div class="mb-5 flex flex-wrap gap-2" id="mode-group" data-value="auto">
      {[
        { id: 'auto', label: 'Auto' },
        { id: 'dark', label: 'Dark' },
        { id: 'light', label: 'Light' },
      ].map((m) => (
        <button data-mode={m.id} class="chip">{m.label}</button>
      ))}
    </div>
    <p class="mb-2 text-sm text-on-surface-variant">Palette style</p>
    <div class="flex flex-wrap gap-2" id="scheme-group" data-value="tonal-spot">
      {[
        { id: 'tonal-spot', label: 'Tonal spot' },
        { id: 'vibrant', label: 'Vibrant' },
        { id: 'expressive', label: 'Expressive' },
        { id: 'fidelity', label: 'Fidelity' },
        { id: 'content', label: 'Content' },
        { id: 'neutral', label: 'Neutral' },
        { id: 'monochrome', label: 'Monochrome' },
        { id: 'rainbow', label: 'Rainbow' },
        { id: 'fruit-salad', label: 'Fruit salad' },
      ].map((s) => (
        <button data-scheme={s.id} class="chip">{s.label}</button>
      ))}
    </div>
    <p class="mb-2 mt-5 text-sm text-on-surface-variant">Color source</p>
    <div class="mb-3 flex flex-wrap items-center gap-2">
      <button data-source="wallpaper" id="source-wallpaper" class="chip">Wallpaper</button>
      <label id="source-color-chip" class="chip cursor-pointer flex items-center gap-2">
        <span>Custom color</span>
        <input id="source-color" type="color" value="#7c4dff" class="size-6 rounded-full bg-transparent outline-none" />
      </label>
    </div>
    <p id="theme-status" class="text-sm text-on-surface-variant"></p>
  </section>

  <section class="mb-6 max-w-3xl rounded-[28px] bg-surface-container p-6">
    <h2 class="mb-1 text-xl font-medium">Effects</h2>
    <div class="mb-5 flex items-center justify-between">
      <div>
        <p class="font-medium">Glass blur</p>
        <p class="text-sm text-on-surface-variant">Frosted blur on the player bar and panels.</p>
      </div>
      <button id="blur-toggle" class="switch" data-on="true"><span class="knob"></span></button>
    </div>
    <div>
      <p class="font-medium">UI scale</p>
      <p class="mb-4 text-sm text-on-surface-variant">Dynamic follows your system's text scaling, a touch smaller so more fits.</p>
      <div class="flex flex-wrap items-center gap-4">
        <button data-scale="dynamic" id="scale-dynamic" class="chip">Dynamic</button>
        <div id="scale-slider" class="xslider w-64 max-w-full">
          <input id="scale-input" type="range" min="50" max="125" step="5" aria-label="UI scale" />
          <div class="xtrack"></div>
          <div class="xfill"></div>
          <div class="xhandle"></div>
        </div>
        <span id="scale-label" class="w-20 text-sm tabular-nums text-on-surface-variant"></span>
      </div>
    </div>
  </section>

  <section class="mb-6 max-w-3xl rounded-[28px] bg-surface-container p-6">
    <h2 class="mb-1 text-xl font-medium">Playback</h2>
    <p class="mb-5 text-sm text-on-surface-variant">Starting volume for each session.</p>
    <div class="mb-6 flex items-center gap-4">
      <span class="ms text-on-surface-variant">volume_down</span>
      <div class="xslider w-64 max-w-full">
        <input id="volume-default" type="range" min="0" max="100" aria-label="Default volume" />
        <div class="xtrack"></div>
        <div class="xfill"></div>
        <div class="xhandle"></div>
      </div>
      <span id="volume-label" class="w-10 text-sm tabular-nums text-on-surface-variant"></span>
    </div>
    <p class="mb-2 text-sm text-on-surface-variant">Audio quality</p>
    <div class="mb-6 flex flex-wrap gap-2" id="quality-group" data-value="max">
      {[
        { id: 'max', label: 'Max' },
        { id: 'high', label: 'High' },
        { id: 'low', label: 'Low' },
      ].map((q) => (
        <button data-quality={q.id} class="chip">{q.label}</button>
      ))}
    </div>
    <p class="mb-4 text-sm text-on-surface-variant">Speed and pitch apply to whatever is playing, right away.</p>
    <div class="mb-4 flex flex-wrap items-center gap-4">
      <span class="ms text-on-surface-variant">speed</span>
      <div id="speed-slider" class="xslider w-64 max-w-full">
        <input id="speed-input" type="range" min="50" max="200" step="5" aria-label="Playback speed" />
        <div class="xtrack"></div>
        <div class="xfill"></div>
        <div class="xhandle"></div>
      </div>
      <button id="speed-reset" class="chip">Reset</button>
      <span id="speed-label" class="w-14 text-sm tabular-nums text-on-surface-variant">1.00×</span>
    </div>
    <div class="mb-6 flex flex-wrap items-center gap-4">
      <span class="ms text-on-surface-variant">graphic_eq</span>
      <div id="pitch-slider" class="xslider w-64 max-w-full">
        <input id="pitch-input" type="range" min="-12" max="12" step="1" aria-label="Pitch" />
        <div class="xtrack"></div>
        <div class="xfill"></div>
        <div class="xhandle"></div>
      </div>
      <button id="pitch-reset" class="chip">Reset</button>
      <span id="pitch-label" class="w-14 text-sm tabular-nums text-on-surface-variant">0 st</span>
    </div>
    <p class="mb-2 text-sm text-on-surface-variant">Equalizer</p>
    <div class="mb-4 flex flex-wrap gap-2" id="eq-presets">
      {['Flat', 'Bass', 'Vocal', 'Treble'].map((p) => (
        <button data-eq={p.toLowerCase()} class="chip">{p}</button>
      ))}
    </div>
    <div id="eq-bands" class="grid max-w-2xl grid-cols-2 gap-x-8 gap-y-3">
      {['30 Hz', '60 Hz', '120 Hz', '240 Hz', '470 Hz', '950 Hz', '1.9 kHz', '3.8 kHz', '7.5 kHz', '15 kHz'].map((f, i) => (
        <div class="flex items-center gap-3">
          <span class="w-16 shrink-0 text-xs tabular-nums text-on-surface-variant">{f}</span>
          <div class="eq-slider xslider min-w-0 flex-1" data-band={i}>
            <input type="range" min="-12" max="12" step="1" aria-label={`Band ${f}`} />
            <div class="xtrack"></div>
            <div class="xfill"></div>
            <div class="xhandle"></div>
          </div>
          <span class="eq-gain w-12 shrink-0 text-right text-xs tabular-nums text-on-surface-variant">0 dB</span>
        </div>
      ))}
    </div>
  </section>

  <section class="max-w-3xl rounded-[28px] bg-surface-container p-6">
    <h2 class="mb-1 text-xl font-medium">Data</h2>
    <p class="mb-4 text-sm text-on-surface-variant">Everything is stored locally on this machine.</p>
    <div class="flex flex-wrap gap-3">
      <button id="clear-recent" class="chip">Clear listening history</button>
      <button id="clear-likes" class="chip">Clear liked songs</button>
      <button id="reset-all" class="chip">Reset everything</button>
    </div>
  </section>
</Layout>
<script>
  import { loadOpts, saveOpts, pushTheme, applyScaleSoon, type ThemeOpts } from '../lib/theme';
  import { systemScale, setSpeed, setPitch, setEq } from '../lib/api';
  import { setVolume, setQuality, type Quality } from '../lib/player';
  import { clearLikes, clearRecent } from '../lib/library';

  document.addEventListener('astro:page-load', () => {
    const status = document.getElementById('theme-status')!;
    const modeGroup = document.getElementById('mode-group')!;
    const schemeGroup = document.getElementById('scheme-group')!;
    const blurToggle = document.getElementById('blur-toggle')!;
    const scaleDynamic = document.getElementById('scale-dynamic')!;
    const scaleSlider = document.getElementById('scale-slider')!;
    const scaleInput = document.getElementById('scale-input') as HTMLInputElement;
    const scaleLabel = document.getElementById('scale-label')!;
    const volInput = document.getElementById('volume-default') as HTMLInputElement;
    const volLabel = document.getElementById('volume-label')!;
    const colorInput = document.getElementById('source-color') as HTMLInputElement;
    const sourceWallpaper = document.getElementById('source-wallpaper')!;
    const sourceColorChip = document.getElementById('source-color-chip')!;
    const qualityGroup = document.getElementById('quality-group')!;
    const speedSlider = document.getElementById('speed-slider')!;
    const speedInput = document.getElementById('speed-input') as HTMLInputElement;
    const speedLabel = document.getElementById('speed-label')!;
    const pitchSlider = document.getElementById('pitch-slider')!;
    const pitchInput = document.getElementById('pitch-input') as HTMLInputElement;
    const pitchLabel = document.getElementById('pitch-label')!;
    const eqBands = document.getElementById('eq-bands')!;
    const eqPresets = document.getElementById('eq-presets')!;

    let opts: ThemeOpts = loadOpts();
    let colorCache = opts.source.color ?? '#7c4dff';
    let dyn = 90;

    const EQ_KEY = 'melissm.eq';
    const readEq = (): number[] => {
      try {
        const v = JSON.parse(localStorage.getItem(EQ_KEY) ?? '[]');
        return Array.isArray(v) && v.length === 10 ? v.map((n) => Math.max(-12, Math.min(12, +n))) : Array(10).fill(0);
      } catch {
        return Array(10).fill(0);
      }
    };
    let eq = readEq();

    const paintEq = () => {
      eqBands.querySelectorAll<HTMLElement>('.eq-slider').forEach((el) => {
        const input = el.querySelector('input')!;
        const g = eq[+el.dataset.band!];
        input.value = String(g);
        const ratio = (g + 12) / 24;
        el.style.setProperty('--p', `${ratio * 100}%`);
        el.style.setProperty('--p-num', String(ratio));
        el.dataset.at = g <= -12 ? 'start' : g >= 12 ? 'end' : 'mid';
        el.parentElement!.querySelector<HTMLElement>('.eq-gain')!.textContent = `${g} dB`;
      });
    };

    const paint = () => {
      modeGroup.dataset.value = opts.mode;
      schemeGroup.dataset.value = opts.scheme;
      blurToggle.dataset.on = String(opts.blur);
      scaleDynamic.classList.toggle('on', opts.scale === 'dynamic');
      const manual = typeof opts.scale === 'number' ? Math.round(opts.scale * 100) : dyn;
      scaleInput.value = String(manual);
      scaleSlider.style.setProperty('--p', `${((manual - 50) / 75) * 100}%`);
      scaleSlider.style.setProperty('--p-num', String((manual - 50) / 75));
      scaleSlider.dataset.at = manual <= 50 ? 'start' : manual >= 125 ? 'end' : 'mid';
      scaleLabel.textContent = opts.scale === 'dynamic' ? `Dynamic ${dyn}%` : `${manual}%`;
      modeGroup.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((b) =>
        b.classList.toggle('on', b.dataset.mode === opts.mode),
      );
      schemeGroup.querySelectorAll<HTMLButtonElement>('[data-scheme]').forEach((b) =>
        b.classList.toggle('on', b.dataset.scheme === opts.scheme),
      );
      const source = opts.source.color ? 'color' : 'wallpaper';
      sourceWallpaper.classList.toggle('on', source === 'wallpaper');
      sourceColorChip.classList.toggle('on', source === 'color');
      colorInput.value = opts.source.color ?? colorCache;
      volInput.value = String(Math.round(parseFloat(localStorage.getItem('melissm.volume') ?? '1') * 100));
      volLabel.textContent = volInput.value;
      const vp = volInput.parentElement!;
      vp.style.setProperty('--p', `${volInput.value}%`);
      vp.style.setProperty('--p-num', String(+volInput.value / 100));
      vp.dataset.at = volInput.value === '0' ? 'start' : volInput.value === '100' ? 'end' : 'mid';
      const q = localStorage.getItem('melissm.quality') ?? 'max';
      qualityGroup.dataset.value = q;
      qualityGroup.querySelectorAll<HTMLButtonElement>('[data-quality]').forEach((b) =>
        b.classList.toggle('on', b.dataset.quality === q),
      );
      const speed = parseFloat(localStorage.getItem('melissm.speed') ?? '1');
      speedInput.value = String(Math.round(speed * 100));
      speedSlider.style.setProperty('--p', `${((speed - 0.5) / 1.5) * 100}%`);
      speedSlider.style.setProperty('--p-num', String((speed - 0.5) / 1.5));
      speedSlider.dataset.at = speed <= 0.5 ? 'start' : speed >= 2 ? 'end' : 'mid';
      speedLabel.textContent = `${speed.toFixed(2)}×`;
      const pitch = parseInt(localStorage.getItem('melissm.pitch') ?? '0', 10);
      pitchInput.value = String(pitch);
      pitchSlider.style.setProperty('--p', `${((pitch + 12) / 24) * 100}%`);
      pitchSlider.style.setProperty('--p-num', String((pitch + 12) / 24));
      pitchSlider.dataset.at = pitch <= -12 ? 'start' : pitch >= 12 ? 'end' : 'mid';
      pitchLabel.textContent = pitch === 0 ? '0 st' : `${pitch > 0 ? '+' : ''}${pitch} st`;
      paintEq();
    };

    const commit = async () => {
      saveOpts(opts);
      paint();
      status.textContent = 'Applying palette…';
      const ok = await pushTheme(opts);
      status.textContent = ok
        ? 'Palette applied.'
        : 'Matugen is not installed, falling back to the Caelestia scheme. Run: sudo pacman -S matugen';
    };

    const chip = (el: HTMLElement, sel: string, attr: string, fn: (v: string) => void) => {
      el.querySelectorAll<HTMLButtonElement>(sel).forEach((b) =>
        b.addEventListener('click', () => fn(b.dataset[attr]!)),
      );
    };

    chip(modeGroup, '[data-mode]', 'mode', (v) => { opts.mode = v as ThemeOpts['mode']; void commit(); });
    chip(schemeGroup, '[data-scheme]', 'scheme', (v) => { opts.scheme = v; void commit(); });
    scaleDynamic.addEventListener('click', () => {
      opts.scale = 'dynamic';
      saveOpts(opts);
      paint();
      applyScaleSoon(opts);
    });
    scaleInput.addEventListener('input', () => {
      opts.scale = +scaleInput.value / 100;
      saveOpts(opts);
      paint();
      applyScaleSoon(opts);
    });
    sourceWallpaper.addEventListener('click', () => { opts.source = { wallpaper: null }; void commit(); });
    colorInput.addEventListener('input', () => {
      colorCache = colorInput.value;
      opts.source = { color: colorInput.value };
      void commit();
    });
    blurToggle.addEventListener('click', () => {
      opts.blur = !opts.blur;
      saveOpts(opts);
      paint();
      void pushTheme(opts);
    });
    volInput.addEventListener('input', () => {
      volLabel.textContent = volInput.value;
      void setVolume(+volInput.value / 100);
    });
    chip(qualityGroup, '[data-quality]', 'quality', (v) => {
      setQuality(v as Quality);
      paint();
    });
    speedInput.addEventListener('input', () => {
      const speed = +speedInput.value / 100;
      localStorage.setItem('melissm.speed', String(speed));
      void setSpeed(speed);
      paint();
    });
    document.getElementById('speed-reset')!.addEventListener('click', () => {
      localStorage.setItem('melissm.speed', '1');
      void setSpeed(1);
      paint();
    });
    pitchInput.addEventListener('input', () => {
      const st = +pitchInput.value;
      localStorage.setItem('melissm.pitch', String(st));
      void setPitch(Math.pow(2, st / 12));
      paint();
    });
    document.getElementById('pitch-reset')!.addEventListener('click', () => {
      localStorage.setItem('melissm.pitch', '0');
      void setPitch(1);
      paint();
    });
    eqBands.addEventListener('input', (e) => {
      const el = (e.target as HTMLInputElement).closest<HTMLElement>('.eq-slider');
      if (!el) return;
      eq[+el.dataset.band!] = +(e.target as HTMLInputElement).value;
      localStorage.setItem(EQ_KEY, JSON.stringify(eq));
      void setEq(+el.dataset.band!, eq[+el.dataset.band!]);
      paintEq();
    });
    const applyEq = (gains: number[]) => {
      eq = gains;
      localStorage.setItem(EQ_KEY, JSON.stringify(eq));
      gains.forEach((g, i) => void setEq(i, g));
      paintEq();
    };
    chip(eqPresets, '[data-eq]', 'eq', (v) => {
      if (v === 'bass') applyEq([6, 5, 3, 1, 0, 0, 0, 0, 0, 0]);
      else if (v === 'vocal') applyEq([-2, -1, 0, 3, 5, 5, 3, 1, 0, -1]);
      else if (v === 'treble') applyEq([0, 0, 0, 0, 0, 1, 3, 5, 6, 6]);
      else applyEq(Array(10).fill(0));
    });
    document.getElementById('clear-recent')!.addEventListener('click', () => {
      clearRecent();
      status.textContent = 'Listening history cleared.';
    });
    document.getElementById('clear-likes')!.addEventListener('click', () => {
      clearLikes();
      status.textContent = 'Liked songs cleared.';
    });
    document.getElementById('reset-all')!.addEventListener('click', () => {
      clearLikes();
      clearRecent();
      localStorage.removeItem('melissm.eq');
      localStorage.removeItem('melissm.speed');
      localStorage.removeItem('melissm.pitch');
      localStorage.removeItem('melissm.quality');
      eq = readEq();
      opts = { mode: 'auto', scheme: 'tonal-spot', source: { wallpaper: null }, blur: true, scale: 'dynamic' };
      void commit();
      void setQuality('max');
      void setSpeed(1);
      void setPitch(1);
      eq.forEach((g, i) => void setEq(i, g));
      status.textContent = 'Everything reset to defaults.';
    });

    paint();
    void systemScale()
      .then((s) => {
        dyn = Math.round(Math.min(1.25, Math.max(0.5, s * 0.9)) * 100);
        paint();
      })
      .catch(() => {});
  });
</script>
