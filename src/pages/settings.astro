---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Settings">
  <h1 class="mb-8 text-5xl font-semibold tracking-tight">Settings</h1>

  <section class="mb-6 max-w-3xl rounded-[28px] bg-surface-container p-6">
    <h2 class="mb-1 text-xl font-medium">Appearance</h2>
    <p class="mb-5 text-sm text-on-surface-variant">Colors follow your wallpaper. Pick the mood.</p>
    <div class="mb-5 flex flex-wrap gap-2" id="mode-group" data-value="auto">
      {[
        { id: 'auto', label: 'Auto' },
        { id: 'dark', label: 'Dark' },
        { id: 'light', label: 'Light' },
      ].map((m) => (
        <button data-mode={m.id} class="chip">{m.label}</button>
      ))}
    </div>
    <p class="mb-2 text-sm text-on-surface-variant">Palette style</p>
    <div class="flex flex-wrap gap-2" id="scheme-group" data-value="tonal-spot">
      {[
        { id: 'tonal-spot', label: 'Tonal spot' },
        { id: 'vibrant', label: 'Vibrant' },
        { id: 'expressive', label: 'Expressive' },
        { id: 'fidelity', label: 'Fidelity' },
        { id: 'content', label: 'Content' },
        { id: 'neutral', label: 'Neutral' },
        { id: 'monochrome', label: 'Monochrome' },
        { id: 'rainbow', label: 'Rainbow' },
        { id: 'fruit-salad', label: 'Fruit salad' },
      ].map((s) => (
        <button data-scheme={s.id} class="chip">{s.label}</button>
      ))}
    </div>
    <p class="mb-2 mt-5 text-sm text-on-surface-variant">Color source</p>
    <div class="mb-3 flex flex-wrap items-center gap-2">
      <button data-source="wallpaper" id="source-wallpaper" class="chip">Wallpaper</button>
      <button data-source="artwork" id="source-artwork" class="chip">Dynamic</button>
      <button id="source-color-chip" class="chip flex cursor-pointer items-center gap-2">
        <span id="source-swatch" class="size-4 shrink-0 rounded-full ring-1 ring-outline-variant" style="background: var(--md-sys-color-primary)"></span>
        <span>Custom color</span>
      </button>
      <input id="source-color" type="color" class="hidden" tabindex="-1" aria-hidden="true" />
    </div>
    <p class="mb-2 mt-5 text-sm text-on-surface-variant">Color changes</p>
    <div class="mb-3 flex flex-wrap items-center gap-4">
      <button id="anim-toggle" class="chip">Animated transitions</button>
    </div>
    <p id="theme-status" class="text-sm text-on-surface-variant"></p>
  </section>

  <section class="mb-6 max-w-3xl rounded-[28px] bg-surface-container p-6">
    <h2 class="mb-1 text-xl font-medium">Effects</h2>
    <div class="mb-5 flex items-center justify-between">
      <div>
        <p class="font-medium">Glass blur</p>
        <p class="text-sm text-on-surface-variant">Frosted blur on the player bar and panels.</p>
      </div>
      <button id="blur-toggle" class="switch" data-on="true"><span class="knob"></span></button>
    </div>
    <div class="mb-5 flex items-center justify-between">
      <div>
        <p class="font-medium">Auto close panels</p>
        <p class="text-sm text-on-surface-variant">Opening the full player closes the queue and lyrics panels.</p>
      </div>
      <button id="panel-toggle" class="switch" data-on="true"><span class="knob"></span></button>
    </div>
    <div class="mb-5 flex items-center justify-between">
      <div>
        <p class="font-medium">Fussion (experimental)</p>
        <p class="text-sm text-on-surface-variant">Experimental beat matched blends between songs. Turn this on to show the toggle next to the player controls.</p>
      </div>
      <button id="fusion-ui-toggle" class="switch" data-on="false"><span class="knob"></span></button>
    </div>
    <div>
      <p class="font-medium">UI scale</p>
      <p class="mb-4 text-sm text-on-surface-variant">Dynamic follows your system's text scaling, a touch smaller so more fits.</p>
      <div class="flex flex-wrap items-center gap-4">
        <button data-scale="dynamic" id="scale-dynamic" class="chip">Dynamic</button>
        <div id="scale-slider" class="xslider w-64 max-w-full">
          <input id="scale-input" type="range" min="50" max="125" step="5" aria-label="UI scale" />
          <div class="xtrack"></div>
          <div class="xfill"></div>
          <div class="xhandle"></div>
        </div>
        <span id="scale-label" class="w-20 text-sm tabular-nums text-on-surface-variant"></span>
      </div>
    </div>
  </section>

  <section class="mb-6 max-w-3xl rounded-[28px] bg-surface-container p-6">
    <h2 class="mb-1 text-xl font-medium">Playback</h2>
    <p class="mb-5 text-sm text-on-surface-variant">Starting volume for each session.</p>
    <div class="mb-6 flex items-center gap-4">
      <span class="ms text-on-surface-variant">volume_down</span>
      <div class="xslider w-64 max-w-full">
        <input id="volume-default" type="range" min="0" max="100" aria-label="Default volume" />
        <div class="xtrack"></div>
        <div class="xfill"></div>
        <div class="xhandle"></div>
      </div>
      <span id="volume-label" class="w-10 text-sm tabular-nums text-on-surface-variant"></span>
    </div>
    <p class="mb-2 text-sm text-on-surface-variant">Audio quality</p>
    <div class="mb-6 flex flex-wrap gap-2" id="quality-group" data-value="max">
      {[
        { id: 'max', label: 'Max' },
        { id: 'high', label: 'High' },
        { id: 'low', label: 'Low' },
      ].map((q) => (
        <button data-quality={q.id} class="chip">{q.label}</button>
      ))}
    </div>
    <p class="mb-4 text-sm text-on-surface-variant">Speed and pitch apply to whatever is playing, right away.</p>
    <div class="mb-4 flex flex-wrap items-center gap-4">
      <span class="ms text-on-surface-variant">transition_fade</span>
      <div id="fade-slider" class="xslider w-64 max-w-full">
        <input id="fade-input" type="range" min="0" max="12" step="1" aria-label="Crossfade" />
        <div class="xtrack"></div>
        <div class="xfill"></div>
        <div class="xhandle"></div>
      </div>
      <span id="fade-label" class="w-16 text-sm tabular-nums text-on-surface-variant">Off</span>
    </div>
    <div class="mb-4 flex flex-wrap items-center gap-4">
      <span class="ms text-on-surface-variant">speed</span>
      <div id="speed-slider" class="xslider w-64 max-w-full">
        <input id="speed-input" type="range" min="50" max="200" step="5" aria-label="Playback speed" />
        <div class="xtrack"></div>
        <div class="xfill"></div>
        <div class="xhandle"></div>
      </div>
      <button id="speed-reset" class="chip">Reset</button>
      <span id="speed-label" class="w-14 text-sm tabular-nums text-on-surface-variant">1.00×</span>
    </div>
    <div class="mb-6 flex flex-wrap items-center gap-4">
      <span class="ms text-on-surface-variant">graphic_eq</span>
      <div id="pitch-slider" class="xslider w-64 max-w-full">
        <input id="pitch-input" type="range" min="-12" max="12" step="1" aria-label="Pitch" />
        <div class="xtrack"></div>
        <div class="xfill"></div>
        <div class="xhandle"></div>
      </div>
      <button id="pitch-reset" class="chip">Reset</button>
      <span id="pitch-label" class="w-14 text-sm tabular-nums text-on-surface-variant">0 st</span>
    </div>
    <p class="mb-2 text-sm text-on-surface-variant">Equalizer</p>
    <div class="mb-4 flex flex-wrap gap-2" id="eq-presets">
      {['Flat', 'Bass', 'Vocal', 'Treble'].map((p) => (
        <button data-eq={p.toLowerCase()} class="chip">{p}</button>
      ))}
    </div>
    <div id="eq-bands" class="grid max-w-2xl grid-cols-2 gap-x-8 gap-y-3">
      {['30 Hz', '60 Hz', '120 Hz', '240 Hz', '470 Hz', '950 Hz', '1.9 kHz', '3.8 kHz', '7.5 kHz', '15 kHz'].map((f, i) => (
        <div class="flex items-center gap-3">
          <span class="w-16 shrink-0 text-xs tabular-nums text-on-surface-variant">{f}</span>
          <div class="eq-slider xslider min-w-0 flex-1" data-band={i}>
            <input type="range" min="-12" max="12" step="1" aria-label={`Band ${f}`} />
            <div class="xtrack"></div>
            <div class="xfill"></div>
            <div class="xhandle"></div>
          </div>
          <span class="eq-gain w-12 shrink-0 text-right text-xs tabular-nums text-on-surface-variant">0 dB</span>
        </div>
      ))}
    </div>
  </section>

  <section class="mb-6 max-w-3xl rounded-[28px] bg-surface-container p-6">
    <h2 class="mb-1 text-xl font-medium">Lyrics</h2>
    <p class="mb-4 text-sm text-on-surface-variant">LRCLIB has word-by-word timing when available, NetEase is the fallback. Offset shifts every line.</p>
    <div class="mb-6 flex flex-wrap gap-2" id="lyr-providers">
      <button id="lyr-lrclib" class="chip">LRCLIB</button>
      <button id="lyr-netease" class="chip">NetEase</button>
    </div>
    <div class="flex flex-wrap items-center gap-4">
      <span class="ms text-on-surface-variant">hourglass_empty</span>
      <div id="lyr-offset-slider" class="xslider w-64 max-w-full">
        <input id="lyr-offset-input" type="range" min="-5" max="5" step="0.5" aria-label="Lyrics offset" />
        <div class="xtrack"></div>
        <div class="xfill"></div>
        <div class="xhandle"></div>
      </div>
      <button id="lyr-offset-reset" class="chip">Reset</button>
      <span id="lyr-offset-label" class="w-14 text-sm tabular-nums text-on-surface-variant">0.0s</span>
    </div>
  </section>

  <section class="mb-6 max-w-3xl rounded-[28px] bg-surface-container p-6">
    <h2 class="mb-1 text-xl font-medium">Data</h2>
    <p class="mb-4 text-sm text-on-surface-variant">Everything is stored locally on this machine.</p>
    <div class="mb-5 flex items-center justify-between">
      <div>
        <p class="font-medium">Keep songs offline</p>
        <p class="text-sm text-on-surface-variant">Songs you play get stored for instant replay and offline listening.</p>
      </div>
      <button id="cache-toggle" class="switch" data-on="true"><span class="knob"></span></button>
    </div>
    <div class="flex items-center justify-between">
      <div>
        <p class="font-medium">Auto load playlists</p>
        <p class="text-sm text-on-surface-variant">Long playlists keep loading more songs as the queue runs out.</p>
      </div>
      <button id="autoload-toggle" class="switch" data-on="true"><span class="knob"></span></button>
    </div>
    <div class="mt-5 flex flex-wrap gap-3">
      <button id="clear-recent" class="chip">Clear listening history</button>
      <button id="clear-likes" class="chip">Clear liked songs</button>
      <button id="clear-cache" class="chip">Clear downloaded songs</button>
      <button id="reset-all" class="chip">Reset everything</button>
    </div>
    <p id="cache-status" class="mt-4 text-sm text-on-surface-variant"></p>
    <p id="data-status" class="mt-2 text-sm text-on-surface-variant"></p>
  </section>

  <div id="snake-wrap" class="fixed right-[3.5vw] top-[12vh] bottom-[7.5rem] z-10 hidden items-center justify-center 2xl:flex">
    <p id="snake-score" class="pointer-events-none absolute right-7 top-5 z-10 hidden font-mono text-lg font-semibold tabular-nums">0</p>
    <canvas id="snake-canvas" width="720" height="720" class="block cursor-pointer"></canvas>
  </div>
</Layout>
<script>
  import { loadOpts, saveOpts, pushTheme, applyScaleSoon, type ThemeOpts } from '../lib/theme';
  import { cacheClear, cacheInfo, getSettings, lyricsSetOffset, lyricsSetProvider, setAutocache, setAutoload, setFusion, setFusionUi, setPanelClose, setSpeed, setPitch, setEq, systemScale } from '../lib/api';
  import { getQuality, getVolume, setVolume, setQuality, setCrossfade, type Quality } from '../lib/player';
  import { clearLikes, clearHistory, deletePlaylist, getPlaylists, initLibrary } from '../lib/library';
  import { confirmDialog, esc } from '../lib/ui';
  import { mountSnake } from '../lib/games';
  import { onPage } from '../lib/page';

  onPage('/settings', () => {
    const status = document.getElementById('theme-status')!;
    const modeGroup = document.getElementById('mode-group')!;
    const schemeGroup = document.getElementById('scheme-group')!;
    const blurToggle = document.getElementById('blur-toggle')!;
    const panelToggle = document.getElementById('panel-toggle')!;
    const fusionUiToggle = document.getElementById('fusion-ui-toggle')!;
    const scaleDynamic = document.getElementById('scale-dynamic')!;
    const scaleSlider = document.getElementById('scale-slider')!;
    const scaleInput = document.getElementById('scale-input') as HTMLInputElement;
    const scaleLabel = document.getElementById('scale-label')!;
    const volInput = document.getElementById('volume-default') as HTMLInputElement;
    const volLabel = document.getElementById('volume-label')!;
    const colorInput = document.getElementById('source-color') as HTMLInputElement;
    const sourceWallpaper = document.getElementById('source-wallpaper')!;
    const sourceArtwork = document.getElementById('source-artwork')!;
    const sourceColorChip = document.getElementById('source-color-chip')!;
    const animToggle = document.getElementById('anim-toggle')!;
    const fadeSlider = document.getElementById('fade-slider')!;
    const fadeInput = document.getElementById('fade-input') as HTMLInputElement;
    const fadeLabel = document.getElementById('fade-label')!;
    const cacheToggle = document.getElementById('cache-toggle')!;
    const autoloadToggle = document.getElementById('autoload-toggle')!;
    const cacheStatus = document.getElementById('cache-status')!;
    const dataStatus = document.getElementById('data-status')!;
    const qualityGroup = document.getElementById('quality-group')!;
    const speedSlider = document.getElementById('speed-slider')!;
    const speedInput = document.getElementById('speed-input') as HTMLInputElement;
    const speedLabel = document.getElementById('speed-label')!;
    const pitchSlider = document.getElementById('pitch-slider')!;
    const pitchInput = document.getElementById('pitch-input') as HTMLInputElement;
    const pitchLabel = document.getElementById('pitch-label')!;
    const eqBands = document.getElementById('eq-bands')!;
    const eqPresets = document.getElementById('eq-presets')!;
    const lyrLrclib = document.getElementById('lyr-lrclib')!;
    const lyrNetease = document.getElementById('lyr-netease')!;
    const lyrOffsetSlider = document.getElementById('lyr-offset-slider')!;
    const lyrOffsetInput = document.getElementById('lyr-offset-input') as HTMLInputElement;
    const lyrOffsetLabel = document.getElementById('lyr-offset-label')!;
    const swatch = document.getElementById('source-swatch')!;

    let opts: ThemeOpts = loadOpts();
    let dyn = 90;

    const EQ_KEY = 'melissm.eq';
    const readEq = (): number[] => {
      try {
        const v = JSON.parse(localStorage.getItem(EQ_KEY) ?? '[]');
        return Array.isArray(v) && v.length === 10 ? v.map((n) => Math.max(-12, Math.min(12, +n))) : Array(10).fill(0);
      } catch {
        return Array(10).fill(0);
      }
    };
    let eq = readEq();

    const paintEq = () => {
      eqBands.querySelectorAll<HTMLElement>('.eq-slider').forEach((el) => {
        const input = el.querySelector('input')!;
        const g = eq[+el.dataset.band!];
        input.value = String(g);
        const ratio = (g + 12) / 24;
        el.style.setProperty('--p', `${ratio * 100}%`);
        el.style.setProperty('--p-num', String(ratio));
        el.dataset.at = g <= -12 ? 'start' : g >= 12 ? 'end' : 'mid';
        el.parentElement!.querySelector<HTMLElement>('.eq-gain')!.textContent = `${g} dB`;
      });
    };

    const paint = () => {
      modeGroup.dataset.value = opts.mode;
      schemeGroup.dataset.value = opts.scheme;
      blurToggle.dataset.on = String(opts.blur);
      scaleDynamic.classList.toggle('on', opts.scale === 'dynamic');
      const manual = typeof opts.scale === 'number' ? Math.round(opts.scale * 100) : dyn;
      scaleInput.value = String(manual);
      scaleSlider.style.setProperty('--p', `${((manual - 50) / 75) * 100}%`);
      scaleSlider.style.setProperty('--p-num', String((manual - 50) / 75));
      scaleSlider.dataset.at = manual <= 50 ? 'start' : manual >= 125 ? 'end' : 'mid';
      scaleLabel.textContent = opts.scale === 'dynamic' ? `Dynamic ${dyn}%` : `${manual}%`;
      modeGroup.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((b) =>
        b.classList.toggle('on', b.dataset.mode === opts.mode),
      );
      schemeGroup.querySelectorAll<HTMLButtonElement>('[data-scheme]').forEach((b) =>
        b.classList.toggle('on', b.dataset.scheme === opts.scheme),
      );
      const source = opts.source.color ? 'color' : 'artwork' in opts.source ? 'artwork' : 'wallpaper';
      sourceWallpaper.classList.toggle('on', source === 'wallpaper');
      sourceArtwork.classList.toggle('on', source === 'artwork');
      sourceColorChip.classList.toggle('on', source === 'color');
      const hex = opts.source.color ?? localStorage.getItem('melissm.custom-color') ?? '';
      colorInput.value = hex || '#7c4dff';
      swatch.style.background = source === 'color' ? colorInput.value : 'var(--md-sys-color-primary)';
      animToggle.classList.toggle('on', localStorage.getItem('melissm.anim') !== '0');
      const fade = parseInt(localStorage.getItem('melissm.crossfade') ?? '0', 10) || 0;
      fadeInput.value = String(fade);
      fadeSlider.style.setProperty('--p', `${(fade / 12) * 100}%`);
      fadeSlider.style.setProperty('--p-num', String(fade / 12));
      fadeSlider.dataset.at = fade === 0 ? 'start' : fade >= 12 ? 'end' : 'mid';
      fadeLabel.textContent = fade === 0 ? 'Off' : `${fade}s`;
      volInput.value = String(Math.round(getVolume() * 100));
      volLabel.textContent = volInput.value;
      const vp = volInput.parentElement!;
      vp.style.setProperty('--p', `${volInput.value}%`);
      vp.style.setProperty('--p-num', String(+volInput.value / 100));
      vp.dataset.at = volInput.value === '0' ? 'start' : volInput.value === '100' ? 'end' : 'mid';
      const q = getQuality();
      qualityGroup.dataset.value = q;
      qualityGroup.querySelectorAll<HTMLButtonElement>('[data-quality]').forEach((b) =>
        b.classList.toggle('on', b.dataset.quality === q),
      );
      const speed = parseFloat(localStorage.getItem('melissm.speed') ?? '1');
      speedInput.value = String(Math.round(speed * 100));
      speedSlider.style.setProperty('--p', `${((speed - 0.5) / 1.5) * 100}%`);
      speedSlider.style.setProperty('--p-num', String((speed - 0.5) / 1.5));
      speedSlider.dataset.at = speed <= 0.5 ? 'start' : speed >= 2 ? 'end' : 'mid';
      speedLabel.textContent = `${speed.toFixed(2)}×`;
      const pitch = parseInt(localStorage.getItem('melissm.pitch') ?? '0', 10);
      pitchInput.value = String(pitch);
      pitchSlider.style.setProperty('--p', `${((pitch + 12) / 24) * 100}%`);
      pitchSlider.style.setProperty('--p-num', String((pitch + 12) / 24));
      pitchSlider.dataset.at = pitch <= -12 ? 'start' : pitch >= 12 ? 'end' : 'mid';
      pitchLabel.textContent = pitch === 0 ? '0 st' : `${pitch > 0 ? '+' : ''}${pitch} st`;
      paintEq();
    };

    const commit = async () => {
      saveOpts(opts);
      paint();
      status.textContent = 'Applying palette…';
      const ok = await pushTheme(opts);
      status.textContent = ok
        ? 'Palette applied.'
        : 'Matugen is not installed, falling back to the Caelestia scheme. Run: sudo pacman -S matugen';
    };

    const chip = (el: HTMLElement, sel: string, attr: string, fn: (v: string) => void) => {
      el.querySelectorAll<HTMLButtonElement>(sel).forEach((b) =>
        b.addEventListener('click', () => fn(b.dataset[attr]!)),
      );
    };

    chip(modeGroup, '[data-mode]', 'mode', (v) => { opts.mode = v as ThemeOpts['mode']; void commit(); });
    chip(schemeGroup, '[data-scheme]', 'scheme', (v) => { opts.scheme = v; void commit(); });
    scaleDynamic.addEventListener('click', () => {
      opts.scale = 'dynamic';
      saveOpts(opts);
      paint();
      applyScaleSoon(opts);
    });
    scaleInput.addEventListener('input', () => {
      opts.scale = +scaleInput.value / 100;
      saveOpts(opts);
      paint();
      applyScaleSoon(opts);
    });
    sourceWallpaper.addEventListener('click', () => { opts.source = { wallpaper: null }; void commit(); });
    sourceArtwork.addEventListener('click', () => { opts.source = { artwork: null }; void commit(); });
    animToggle.addEventListener('click', () => {
      const on = localStorage.getItem('melissm.anim') !== '0';
      localStorage.setItem('melissm.anim', on ? '0' : '1');
      paint();
    });
    fadeInput.addEventListener('input', () => {
      const fade = +fadeInput.value;
      localStorage.setItem('melissm.crossfade', String(fade));
      setCrossfade(fade);
      paint();
    });
    const paintCache = async () => {
      try {
        const bytes = await cacheInfo();
        const mb = bytes / 1024 / 1024;
        cacheStatus.textContent = `Downloaded songs take up ${mb < 1 ? `${Math.round(bytes / 1024)} KB` : `${mb.toFixed(1)} MB`}.`;
      } catch {
        cacheStatus.textContent = '';
      }
    };
    const cacheOn = getSettings().then((s) => {
      cacheToggle.dataset.on = String(s.autocache !== '0');
      autoloadToggle.dataset.on = String(s.autoload !== '0');
      lyrLrclib.classList.toggle('on', s.lyr_lrclib !== '0');
      lyrNetease.classList.toggle('on', s.lyr_netease !== '0');
      panelToggle.dataset.on = String(s.panel_close !== '0');
      fusionUiToggle.dataset.on = String(s.fusion_ui === '1');
      return s.autocache !== '0';
    });
    cacheToggle.addEventListener('click', async () => {
      const on = (cacheToggle.dataset.on ?? 'true') !== 'true';
      cacheToggle.dataset.on = String(on);
      void setAutocache(on);
    });
    autoloadToggle.addEventListener('click', () => {
      const on = (autoloadToggle.dataset.on ?? 'true') !== 'true';
      autoloadToggle.dataset.on = String(on);
      void setAutoload(on);
    });
    panelToggle.addEventListener('click', () => {
      const on = (panelToggle.dataset.on ?? 'true') !== 'true';
      panelToggle.dataset.on = String(on);
      void setPanelClose(on);
      window.dispatchEvent(new CustomEvent('melissm:panel-close', { detail: on }));
    });
    fusionUiToggle.addEventListener('click', () => {
      const on = (fusionUiToggle.dataset.on ?? 'false') !== 'true';
      fusionUiToggle.dataset.on = String(on);
      void setFusionUi(on);
      if (!on) void setFusion(false);
      window.dispatchEvent(new CustomEvent('melissm:fusion-ui', { detail: on }));
    });
    document.getElementById('clear-cache')!.addEventListener('click', async () => {
      if (!(await confirmDialog('Delete all downloaded songs?'))) return;
      await cacheClear();
      void paintCache();
      dataStatus.textContent = 'Downloaded songs cleared.';
    });
    colorInput.addEventListener('input', () => {
      opts.source = { color: colorInput.value };
      void commit();
    });
    const SWATCHES = [
      '#e57373', '#f06292', '#ba68c8', '#9c27b0', '#7e57c2', '#5c6bc0',
      '#42a5f5', '#29b6f6', '#26a69a', '#66bb6a', '#9ccc65', '#d4e157',
      '#ffca28', '#ffa726', '#ff7043', '#a1887f', '#90a4ae', '#78909c',
    ];
    let pickerEl: HTMLElement | null = null;
    let pickerOutside: ((e: MouseEvent) => void) | null = null;
    const closePicker = () => {
      pickerEl?.remove();
      pickerEl = null;
      if (pickerOutside) {
        document.removeEventListener('click', pickerOutside);
        pickerOutside = null;
      }
    };
    sourceColorChip.addEventListener('click', () => {
      if (pickerEl) {
        closePicker();
        return;
      }
      const cur = colorInput.value || '#7c4dff';
      if (!(opts.source as { color?: string }).color) {
        opts.source = { color: cur };
        void commit();
      }
      pickerEl = document.createElement('div');
      pickerEl.className = 'fixed z-[75] w-72 rounded-[28px] bg-surface-container-high p-5 shadow-2xl shadow-black/50';
      pickerEl.innerHTML = `<p class="mb-3 text-base font-medium">Pick a color</p>
        <div class="grid grid-cols-6 gap-2">${SWATCHES.map((c) => `<button data-hex="${c}" class="press size-9 rounded-full ring-1 ring-outline-variant" style="background:${c}" aria-label="${c}"></button>`).join('')}</div>
        <div class="mt-4 flex items-center gap-2">
          <input data-hexin type="text" value="${esc(cur)}" placeholder="#7c4dff" spellcheck="false" class="h-11 min-w-0 flex-1 rounded-full bg-surface-container-highest px-4 text-sm outline-none" />
          <button data-apply class="press h-11 rounded-full bg-primary px-4 text-sm font-medium text-on-primary">Apply</button>
        </div>`;
      document.body.appendChild(pickerEl);
      const r = sourceColorChip.getBoundingClientRect();
      pickerEl.style.top = `${r.bottom + 8}px`;
      pickerEl.style.left = `${Math.max(8, Math.min(window.innerWidth - pickerEl.offsetWidth - 8, r.right - pickerEl.offsetWidth))}px`;
      const apply = (hex: string) => {
        hex = hex.trim().replace(/^#*/, '');
        if (!/^[0-9a-fA-F]{6}$/.test(hex)) return;
        localStorage.setItem('melissm.custom-color', hex);
        closePicker();
        colorInput.value = `#${hex}`;
        colorInput.dispatchEvent(new Event('input'));
      };
      pickerEl.querySelectorAll<HTMLButtonElement>('[data-hex]').forEach((b) => b.addEventListener('click', () => apply(b.dataset.hex!)));
      const hexIn = pickerEl.querySelector<HTMLInputElement>('[data-hexin]')!;
      pickerEl.querySelector('[data-apply]')!.addEventListener('click', () => apply(hexIn.value));
      hexIn.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') apply(hexIn.value);
      });
      pickerOutside = (e) => {
        if (!pickerEl?.contains(e.target as Node)) closePicker();
      };
      setTimeout(() => document.addEventListener('click', pickerOutside!), 0);
    });
    blurToggle.addEventListener('click', () => {
      opts.blur = !opts.blur;
      saveOpts(opts);
      paint();
      void pushTheme(opts);
    });
    volInput.addEventListener('input', () => {
      volLabel.textContent = volInput.value;
      void setVolume(+volInput.value / 100);
    });
    chip(qualityGroup, '[data-quality]', 'quality', (v) => {
      setQuality(v as Quality);
      paint();
    });
    speedInput.addEventListener('input', () => {
      const speed = +speedInput.value / 100;
      localStorage.setItem('melissm.speed', String(speed));
      void setSpeed(speed);
      paint();
    });
    document.getElementById('speed-reset')!.addEventListener('click', () => {
      localStorage.setItem('melissm.speed', '1');
      void setSpeed(1);
      paint();
    });
    pitchInput.addEventListener('input', () => {
      const st = +pitchInput.value;
      localStorage.setItem('melissm.pitch', String(st));
      void setPitch(Math.pow(2, st / 12));
      paint();
    });
    document.getElementById('pitch-reset')!.addEventListener('click', () => {
      localStorage.setItem('melissm.pitch', '0');
      void setPitch(1);
      paint();
    });
    eqBands.addEventListener('input', (e) => {
      const el = (e.target as HTMLInputElement).closest<HTMLElement>('.eq-slider');
      if (!el) return;
      eq[+el.dataset.band!] = +(e.target as HTMLInputElement).value;
      localStorage.setItem(EQ_KEY, JSON.stringify(eq));
      void setEq(+el.dataset.band!, eq[+el.dataset.band!]);
      paintEq();
    });
    const applyEq = (gains: number[]) => {
      eq = gains;
      localStorage.setItem(EQ_KEY, JSON.stringify(eq));
      gains.forEach((g, i) => void setEq(i, g));
      paintEq();
    };
    chip(eqPresets, '[data-eq]', 'eq', (v) => {
      if (v === 'bass') applyEq([6, 5, 3, 1, 0, 0, 0, 0, 0, 0]);
      else if (v === 'vocal') applyEq([-2, -1, 0, 3, 5, 5, 3, 1, 0, -1]);
      else if (v === 'treble') applyEq([0, 0, 0, 0, 0, 1, 3, 5, 6, 6]);
      else applyEq(Array(10).fill(0));
    });
    document.getElementById('clear-recent')!.addEventListener('click', async () => {
      if (!(await confirmDialog('Clear your listening history?'))) return;
      clearHistory();
      dataStatus.textContent = 'Listening history cleared.';
    });
    document.getElementById('clear-likes')!.addEventListener('click', async () => {
      if (!(await confirmDialog('Clear all liked songs?'))) return;
      clearLikes();
      dataStatus.textContent = 'Liked songs cleared.';
    });
    document.getElementById('reset-all')!.addEventListener('click', async () => {
      if (!(await confirmDialog('Reset everything? Playlists, history and settings will be wiped.'))) return;
      await initLibrary().catch(() => {});
      for (const p of [...getPlaylists()]) await deletePlaylist(p.id);
      clearLikes();
      clearHistory();
      localStorage.removeItem('melissm.eq');
      localStorage.removeItem('melissm.speed');
      localStorage.removeItem('melissm.pitch');
      localStorage.removeItem('melissm.crossfade');
      localStorage.removeItem('melissm.anim');
      localStorage.removeItem('melissm.custom-color');
      localStorage.removeItem('melissm.lyrics_offset');
      void lyricsSetOffset(0);
      window.dispatchEvent(new Event('melissm:lyr-offset'));
      eq = readEq();
      opts = { mode: 'auto', scheme: 'tonal-spot', source: { wallpaper: null }, blur: true, scale: 'dynamic' };
      void commit();
      void setQuality('max');
      setCrossfade(0);
      void setSpeed(1);
      void setPitch(1);
      void setVolume(1);
      volInput.value = '100';
      volLabel.textContent = '100';
      void lyricsSetProvider('lrclib', true);
      void lyricsSetProvider('netease', true);
      lyrLrclib.classList.add('on');
      lyrNetease.classList.add('on');
      void setAutocache(true);
      void setAutoload(true);
      void setPanelClose(true);
      void setFusion(false);
      void setFusionUi(false);
      window.dispatchEvent(new CustomEvent('melissm:fusion-ui', { detail: false }));
      cacheToggle.dataset.on = 'true';
      autoloadToggle.dataset.on = 'true';
      panelToggle.dataset.on = 'true';
      fusionUiToggle.dataset.on = 'false';
      eq.forEach((g, i) => void setEq(i, g));
      paintLyrOffset();
      dataStatus.textContent = 'Everything reset to defaults.';
    });

    const paintLyrOffset = () => {
      const off = parseFloat(localStorage.getItem('melissm.lyrics_offset') ?? '0') || 0;
      lyrOffsetInput.value = String(off);
      lyrOffsetSlider.style.setProperty('--p', `${((off + 5) / 10) * 100}%`);
      lyrOffsetSlider.style.setProperty('--p-num', String((off + 5) / 10));
      lyrOffsetSlider.dataset.at = off <= -5 ? 'start' : off >= 5 ? 'end' : 'mid';
      lyrOffsetLabel.textContent = `${off > 0 ? '+' : ''}${off.toFixed(1)}s`;
    };
    const commitLyrOffset = (off: number) => {
      localStorage.setItem('melissm.lyrics_offset', String(off));
      void lyricsSetOffset(off);
      paintLyrOffset();
      window.dispatchEvent(new Event('melissm:lyr-offset'));
    };
    lyrOffsetInput.addEventListener('input', () => commitLyrOffset(+lyrOffsetInput.value));
    document.getElementById('lyr-offset-reset')!.addEventListener('click', () => commitLyrOffset(0));
    lyrLrclib.addEventListener('click', () => {
      const on = !lyrLrclib.classList.contains('on');
      lyrLrclib.classList.toggle('on', on);
      void lyricsSetProvider('lrclib', on);
    });
    lyrNetease.addEventListener('click', () => {
      const on = !lyrNetease.classList.contains('on');
      lyrNetease.classList.toggle('on', on);
      void lyricsSetProvider('netease', on);
    });
    paintLyrOffset();
    paint();
    void cacheOn.then(() => paint());
    void paintCache();
    void systemScale()
      .then((s) => {
        dyn = Math.round(Math.min(1.25, Math.max(0.5, s * 0.9)) * 100);
        paint();
      })
      .catch(() => {});

    const wrap = document.getElementById('snake-wrap');
    if (wrap && wrap.parentElement !== document.body) document.body.appendChild(wrap);
    const stopGame = mountSnake(
      document.getElementById('snake-canvas') as HTMLCanvasElement,
      document.getElementById('snake-score')!,
    );
    window.addEventListener(
      'astro:before-swap',
      () => {
        stopGame();
        wrap?.remove();
      },
      { once: true },
    );
  });
</script>
