---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Search">
  <label class="mb-5 flex h-16 items-center gap-3 rounded-full bg-surface-container-high px-6 transition-colors duration-700 focus-within:bg-surface-container-highest">
    <span class="ms text-on-surface-variant">search</span>
    <input id="q" type="text" autocomplete="off" spellcheck="false" placeholder="Songs, artists, albums" class="h-full flex-1 bg-transparent text-lg outline-none placeholder:text-on-surface-variant" />
  </label>
  <div id="chips" class="mb-8 flex gap-2 overflow-x-auto pb-1">
    <button class="chip on" data-filter="all" aria-pressed="true">All</button>
    <button class="chip" data-filter="songs" aria-pressed="false">Songs</button>
    <button class="chip" data-filter="videos" aria-pressed="false">Videos</button>
    <button class="chip" data-filter="albums" aria-pressed="false">Albums</button>
    <button class="chip" data-filter="artists" aria-pressed="false">Artist</button>
    <button class="chip" data-filter="community" aria-pressed="false">Community Playlist</button>
    <button class="chip" data-filter="playlists" aria-pressed="false">Playlist</button>
    <button class="chip" data-filter="profiles" aria-pressed="false">Profiles</button>
  </div>
  <div id="results" class="space-y-8"></div>
  <p id="search-status" class="mt-4 text-on-surface-variant"></p>
</Layout>
<script>
  import { searchSections } from '../lib/api';
  import type { SearchSection } from '../lib/types';
  import { esc, renderCards, renderTracks } from '../lib/ui';
  import { onPage } from '../lib/page';

  onPage('/search', () => {
    const input = document.getElementById('q') as HTMLInputElement | null;
    if (!input) return;
    const chips = document.getElementById('chips')!;
    const results = document.getElementById('results')!;
    const status = document.getElementById('search-status')!;
    let filter = 'all';
    let timer: number;
    let seq = 0;

    const draw = (sections: SearchSection[]) => {
      results.innerHTML = '';
      for (const section of sections) {
        if (!section.tracks.length) continue;
        const sec = document.createElement('section');
        sec.className = 'section-in';
        const cards = section.kind !== 'songs' && section.kind !== 'videos';
        sec.innerHTML = `<h2 class="mb-3 text-2xl font-medium">${esc(section.title)}</h2><div class="${cards ? 'h-row' : 'space-y-1'}"></div>`;
        results.appendChild(sec);
        const box = sec.querySelector<HTMLElement>('div')!;
        if (cards) renderCards(box, section.tracks, { row: true, round: section.kind === 'profiles' });
        else renderTracks(box, section.tracks);
      }
    };

    const run = async () => {
      const q = input.value.trim();
      if (!q) {
        seq++;
        clearTimeout(timer);
        results.innerHTML = '';
        status.textContent = '';
        return;
      }
      const id = ++seq;
      results.innerHTML = '';
      status.textContent = 'Searching…';
      try {
        const sections = await searchSections(q, filter);
        if (id !== seq || !results.isConnected) return;
        const count = sections.reduce((n, s) => n + s.tracks.length, 0);
        status.textContent = count ? '' : `No results for “${q}”. Try a different search.`;
        draw(sections);
      } catch (e) {
        if (id !== seq) return;
        status.textContent = `Search failed: ${e}`;
      }
    };

    chips.addEventListener('click', (e) => {
      const chip = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-filter]');
      if (!chip || chip.dataset.filter === filter) return;
      filter = chip.dataset.filter!;
      chips.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((b) => {
        const on = b === chip;
        b.classList.toggle('on', on);
        b.setAttribute('aria-pressed', String(on));
      });
      clearTimeout(timer);
      void run();
    });

    input.addEventListener('input', () => {
      clearTimeout(timer);
      timer = window.setTimeout(run, 300);
    });
    input.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter') return;
      clearTimeout(timer);
      void run();
    });
    if (document.hasFocus()) input.focus();
  });
</script>
