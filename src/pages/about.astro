---
import Layout from '../layouts/Layout.astro';

const deps = [
  { name: 'Melissm', license: 'GPL-3.0-or-later', file: 'GPL-3.0.txt', url: 'https://github.com/rynekryz/melissm', note: 'This application' },
  { name: 'Metrolist', license: 'GPL-3.0', file: 'GPL-3.0.txt', url: 'https://github.com/MetrolistGroup/Metrolist', note: 'InnerTube extractor approach and lyrics provider design' },
  { name: 'LrcLib', license: 'MIT', file: 'LrcLib-MIT.txt', url: 'https://github.com/tranxuanthang/lrclib', note: 'Synced lyrics service' },
  { name: 'Tauri', license: 'MIT / Apache-2.0', file: 'Tauri-MIT.txt', url: 'https://github.com/tauri-apps/tauri', note: 'Desktop runtime' },
  { name: 'Astro', license: 'MIT', file: 'Astro-MIT.txt', url: 'https://github.com/withastro/astro', note: 'Frontend framework' },
  { name: 'GStreamer', license: 'LGPL-2.1', file: 'GStreamer-LGPL-2.1.txt', url: 'https://gitlab.freedesktop.org/gstreamer/gstreamer', note: 'Audio playback' },
  { name: 'Matugen', license: 'GPL-2.0', file: 'Matugen-GPL-2.0.txt', url: 'https://github.com/InioX/matugen', note: 'Wallpaper color extraction' },
  { name: 'Material Web', license: 'Apache-2.0', file: 'MaterialWeb-Apache-2.0.txt', url: 'https://github.com/material-components/material-web', note: 'Material 3 components' },
  { name: 'Tailwind CSS', license: 'MIT', file: 'Tailwind-MIT.txt', url: 'https://github.com/tailwindlabs/tailwindcss', note: 'Styling' },
  { name: 'reqwest', license: 'MIT / Apache-2.0', file: 'reqwest-MIT.txt', url: 'https://github.com/seanmonstar/reqwest', note: 'HTTP client' },
  { name: 'Tokio', license: 'MIT', file: 'Tokio-MIT.txt', url: 'https://github.com/tokio-rs/tokio', note: 'Async runtime' },
  { name: 'Caelestia', license: 'GPL-3.0', file: 'GPL-3.0.txt', url: 'https://github.com/caelestia-dots/caelestia', note: 'Design and theming inspiration' },
];
---
<Layout title="About">
  <h1 class="mb-2 text-5xl font-semibold tracking-tight">Melissm</h1>
  <p class="mb-8 max-w-xl text-on-surface-variant">It plays music, literally. FOSS music streaming app for Arch Linux, written in Rust. Made with <span class="ms fill align-middle text-[20px]">favorite</span> by <a href="https://github.com/rynekryz" class="text-primary" target="_blank" rel="noreferrer">Ryne</a><br>v0.1.4</p>
  <a href="https://github.com/rynekryz/melissm" target="_blank" rel="noreferrer" class="mb-8 flex max-w-3xl cursor-pointer items-center gap-4 rounded-3xl bg-surface-container px-6 py-4 transition-colors hover:bg-surface-container-high">
    <div class="grid size-10 shrink-0 place-items-center rounded-full bg-secondary-container text-on-secondary-container"><span class="ms fill">code</span></div>
    <div class="flex-1"><div class="font-medium">Source code</div><div class="text-sm text-on-surface-variant">github.com/rynekryz/melissm</div></div>
    <span class="ms text-on-surface-variant">open_in_new</span>
  </a>
  <h2 class="mb-4 text-2xl font-medium">Open source licenses</h2>
  <div class="max-w-3xl space-y-2">
    {deps.map((d) => (
      <details class="group rounded-3xl bg-surface-container px-6 py-4 open:bg-surface-container-high" data-file={d.file}>
        <summary class="flex cursor-pointer list-none items-center gap-4">
          <div class="flex-1"><div class="font-medium">{d.name}</div><div class="text-sm text-on-surface-variant">{d.note}</div></div>
          <span class="rounded-full bg-secondary-container px-3 py-1 text-xs text-on-secondary-container">{d.license}</span>
          <span class="ms transition-transform group-open:rotate-180">expand_more</span>
        </summary>
        <a href={d.url} target="_blank" rel="noreferrer" class="mt-3 inline-block text-sm text-primary underline">{d.url}</a>
        <pre class="license mt-3 max-h-72 overflow-auto whitespace-pre-wrap text-xs text-on-surface-variant"></pre>
      </details>
    ))}
  </div>
</Layout>
<script>
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLDetailsElement>('details[data-file]').forEach((d) => {
      d.addEventListener('toggle', async () => {
        const pre = d.querySelector('pre')!;
        if (!d.open || pre.textContent) return;
        try {
          pre.textContent = await (await fetch(`/licenses/${d.dataset.file}`)).text();
        } catch {
          pre.textContent = 'License text unavailable.';
        }
      });
    });
  });
</script>
