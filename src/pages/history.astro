---
import Layout from '../layouts/Layout.astro';
---
<Layout title="History">
  <div class="mb-8 flex items-center justify-between">
    <h1 class="text-5xl font-semibold tracking-tight">History</h1>
    <button id="clear-history" class="press flex h-14 items-center gap-2 rounded-full bg-primary px-6 font-medium text-on-primary"><span class="ms fill">delete</span>Clear</button>
  </div>
  <div id="history-list" class="space-y-1"></div>
</Layout>
<script>
  import { clearHistory, getHistory, initLibrary, removeHistory, subscribe } from '../lib/library';
  import { confirmDialog } from '../lib/ui';
  import { renderTracks } from '../lib/ui';
  import { onPage } from '../lib/page';

  onPage('/history', async () => {
    const list = document.getElementById('history-list');
    if (!list) return;
    await initLibrary().catch(() => {});
    if (!list.isConnected) return;
    const draw = () =>
      renderTracks(list, getHistory(), {
        onRemove: (t) => {
          removeHistory(t.id);
          draw();
        },
      });
    const off = subscribe(draw);
    window.addEventListener('astro:before-swap', () => off(), { once: true });
    document.getElementById('clear-history')!.addEventListener('click', async () => {
      if (!(await confirmDialog('Clear your listening history?'))) return;
      clearHistory();
      draw();
    });
    draw();
  });
</script>
