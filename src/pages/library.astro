---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Library">
  <div class="mb-8 flex items-center justify-between">
    <h1 class="text-5xl font-semibold tracking-tight">Library</h1>
    <div class="flex items-center gap-3">
      <input id="pl-name" type="text" placeholder="Playlist name" class="h-14 w-56 rounded-full bg-surface-container-high px-6 text-sm outline-none placeholder:text-on-surface-variant focus:bg-surface-container-highest" />
      <button id="new-playlist" class="press flex h-14 items-center gap-2 rounded-full bg-primary px-6 font-medium text-on-primary"><span class="ms fill">add</span>New playlist</button>
    </div>
  </div>
  <section class="mb-10">
    <div class="mb-4 flex items-center justify-between">
      <h2 class="text-2xl font-medium">Liked songs</h2>
      <button id="play-all" class="press flex h-12 items-center gap-2 rounded-full bg-surface-container-high px-5 font-medium"><span class="ms fill">play_arrow</span>Play all</button>
    </div>
    <div id="liked" class="space-y-1"></div>
  </section>
  <section>
    <h2 class="mb-4 text-2xl font-medium">Your playlists</h2>
    <div id="playlists" class="flex flex-wrap gap-4"></div>
  </section>
</Layout>
<script>
  import { createPlaylist, deletePlaylist, getLikes, getPlaylists, subscribe } from '../lib/library';
  import { confirmDialog } from '../lib/ui';
  import { playQueue } from '../lib/player';
  import { esc, renderTracks } from '../lib/ui';
  import { navigate } from 'astro:transitions/client';
  import { onPage } from '../lib/page';

  onPage('/library', () => {
    const liked = document.getElementById('liked')!;
    const plEl = document.getElementById('playlists')!;
    let seenPl = new Set<number>();
    const drawLiked = () => {
      const tracks = getLikes();
      renderTracks(liked, tracks);
      document.getElementById('play-all')!.onclick = () => tracks.length && playQueue(tracks, 0);
    };
    const drawPlaylists = () => {
      const lists = getPlaylists();
      const prev = seenPl;
      seenPl = new Set(lists.map((p) => p.id));
      let born = 0;
      plEl.innerHTML = lists
        .map(
          (p) => {
            const fresh = !prev.has(p.id);
            const delay = fresh ? ` style="animation-delay:${Math.min(born++, 16) * 50}ms"` : '';
            return `<div class="playlist-card group${fresh ? ' card-in' : ''}" data-id="${p.id}"${delay}>
            <div class="relative aspect-square w-full">
              <div class="absolute inset-0 grid place-items-center rounded-[32px] bg-surface-container-highest"><span class="ms text-on-surface-variant opacity-60" style="font-size:56px">queue_music</span></div>
              <button data-del class="press absolute right-2 top-2 grid size-9 place-items-center rounded-full bg-surface-container/90 text-on-surface opacity-0 transition-opacity group-hover:opacity-100" aria-label="Delete playlist"><span class="ms">delete</span></button>
            </div>
            <div class="mt-3 truncate px-2 font-medium">${esc(p.name)}</div>
            <div class="truncate px-2 text-sm text-on-surface-variant">${p.count} song${p.count === 1 ? '' : 's'}</div>
          </div>`;
          },
        )
        .join('');
      plEl.querySelectorAll<HTMLElement>('.playlist-card').forEach((card) => {
        const id = +card.dataset.id!;
        card.onclick = async (e) => {
          if ((e.target as HTMLElement).closest('[data-del]')) {
            const pl = getPlaylists().find((p) => p.id === id);
            if (!(await confirmDialog(`Delete playlist "${pl?.name ?? ''}"?`))) return;
            void deletePlaylist(id).then(drawPlaylists);
            return;
          }
          navigate(`/playlist?id=${id}`);
        };
      });
    };
    drawLiked();
    drawPlaylists();
    const sub = subscribe(() => {
      drawLiked();
      drawPlaylists();
    });
    document.getElementById('new-playlist')!.onclick = async () => {
      const input = document.getElementById('pl-name') as HTMLInputElement;
      const id = await createPlaylist(input.value);
      input.value = '';
      if (id) navigate(`/playlist?id=${id}`);
    };
    document.getElementById('pl-name')!.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') (document.getElementById('new-playlist') as HTMLButtonElement).click();
    });
    window.addEventListener('astro:before-swap', () => sub(), { once: true });
  });
</script>
