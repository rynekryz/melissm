---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Album">
  <div id="head" class="mb-8 flex items-center gap-8">
    <div class="size-52 shrink-0 rounded-[32px] skeleton"></div>
    <div class="flex-1 space-y-4"><div class="h-9 w-64 max-w-full skeleton"></div><div class="h-5 w-40 skeleton"></div></div>
  </div>
  <div id="tracks" class="space-y-1"></div>
  <p id="status" class="text-on-surface-variant"></p>
</Layout>
<script>
  import { album } from '../lib/api';
  import { playQueue } from '../lib/player';
  import { esc, renderTracks } from '../lib/ui';

  document.addEventListener('astro:page-load', async () => {
    const id = new URLSearchParams(location.search).get('id');
    if (!id) return;
    const head = document.getElementById('head')!;
    const list = document.getElementById('tracks')!;
    const status = document.getElementById('status')!;
    try {
      const page = await album(id);
      document.title = `${page.title} · Melissm`;
      head.innerHTML = `
        ${page.thumbnail ? `<img src="${esc(page.thumbnail)}" alt="" class="size-52 shrink-0 rounded-[32px] object-cover shadow-lg shadow-black/30" />` : '<div class="size-52 shrink-0 rounded-[32px] bg-surface-container-highest grid place-items-center"><span class="ms text-on-surface-variant opacity-60" style="font-size:64px">album</span></div>'}
        <div class="min-w-0 flex-1">
          <h1 class="truncate text-5xl font-semibold tracking-tight">${esc(page.title)}</h1>
          <p class="mt-2 truncate text-on-surface-variant">${esc(page.subtitle)}</p>
          <div class="mt-6 flex gap-3">
            <button id="play-all" class="press flex h-14 items-center gap-2 rounded-full bg-primary px-6 font-medium text-on-primary"><span class="ms fill">play_arrow</span>Play</button>
            <button id="play-shuffle" class="press flex h-14 items-center gap-2 rounded-full bg-surface-container-high px-6 font-medium"><span class="ms">shuffle</span>Shuffle</button>
          </div>
        </div>`;
      document.getElementById('play-all')!.onclick = () => page.tracks.length && playQueue(page.tracks, 0);
      document.getElementById('play-shuffle')!.onclick = () => {
        if (!page.tracks.length) return;
        const i = Math.floor(Math.random() * page.tracks.length);
        playQueue(page.tracks, i);
      };
      renderTracks(list, page.tracks);
    } catch (e) {
      status.textContent = `Could not load this one: ${e}`;
    }
  });
</script>
